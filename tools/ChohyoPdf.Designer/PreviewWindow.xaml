<Window x:Class="ChohyoPdf.Designer.PreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ChohyoPdf.Designer"
        Title="プレビュー（確認用の値を差し込んだ PDF）" Width="900" Height="1000" WindowStartupLocation="CenterOwner"
        Background="{StaticResource PanelBackground}">
    <Window.InputBindings>
        <KeyBinding Key="OemPlus" Modifiers="Ctrl" Command="{x:Static local:PreviewWindow.ZoomInCommand}" />
        <KeyBinding Key="Add" Modifiers="Ctrl" Command="{x:Static local:PreviewWindow.ZoomInCommand}" />
        <KeyBinding Key="OemMinus" Modifiers="Ctrl" Command="{x:Static local:PreviewWindow.ZoomOutCommand}" />
        <KeyBinding Key="Subtract" Modifiers="Ctrl" Command="{x:Static local:PreviewWindow.ZoomOutCommand}" />
        <KeyBinding Key="D0" Modifiers="Ctrl" Command="{x:Static local:PreviewWindow.ZoomResetCommand}" />
        <KeyBinding Key="NumPad0" Modifiers="Ctrl" Command="{x:Static local:PreviewWindow.ZoomResetCommand}" />
    </Window.InputBindings>
    <Window.CommandBindings>
        <CommandBinding Command="{x:Static local:PreviewWindow.ZoomInCommand}" Executed="ZoomIn_Click" />
        <CommandBinding Command="{x:Static local:PreviewWindow.ZoomOutCommand}" Executed="ZoomOut_Click" />
        <CommandBinding Command="{x:Static local:PreviewWindow.ZoomResetCommand}" Executed="ZoomReset_Click" />
    </Window.CommandBindings>
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="White" BorderBrush="{StaticResource PanelBorder}" BorderThickness="0,0,0,1" Padding="10,6">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="閉じる" IsCancel="True" Margin="6,0,0,0" Click="Close_Click" />
                <Button DockPanel.Dock="Right" Content="PDF を保存…" Margin="6,0,0,0" Click="Save_Click" />
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
                    <Button Content="−" MinWidth="28" ToolTip="縮小 (Ctrl+-)" AutomationProperties.Name="縮小" Click="ZoomOut_Click" />
                    <Button x:Name="ZoomLabel" Content="100%" MinWidth="52" Margin="2,0" ToolTip="実寸（100%）に戻す (Ctrl+0)" AutomationProperties.Name="表示倍率" Click="ZoomReset_Click" />
                    <Button Content="＋" MinWidth="28" ToolTip="拡大 (Ctrl++)" AutomationProperties.Name="拡大" Click="ZoomIn_Click" />
                    <Button Content="幅に合わせる" Margin="6,0,0,0" ToolTip="ページの幅が、この画面に収まる倍率にする" Click="ZoomFit_Click" />
                </StackPanel>
                <TextBlock x:Name="Status" VerticalAlignment="Center" Text="作成しています…" />
            </DockPanel>
        </Border>
        <Border DockPanel.Dock="Bottom" Background="{StaticResource WarningBackground}" BorderBrush="{StaticResource WarningBorder}" BorderThickness="0,1,0,0" x:Name="WarningPanel" Visibility="Collapsed" MaxHeight="140">
            <ListBox x:Name="WarningList" Background="Transparent" BorderThickness="0" Padding="6" />
        </Border>
        <ScrollViewer x:Name="PageScroll" Background="{StaticResource CanvasBackground}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                      PreviewMouseWheel="PageScroll_PreviewMouseWheel">
            <ItemsControl x:Name="Pages" Margin="0,16">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,0,0,16" HorizontalAlignment="Center">
                            <Border Background="White" BorderBrush="#C8CCD2" BorderThickness="1">
                                <Image Source="{Binding Image}" Width="{Binding DisplayWidth}" RenderOptions.BitmapScalingMode="HighQuality" />
                            </Border>
                            <TextBlock Text="{Binding Label}" HorizontalAlignment="Center" Margin="0,4,0,0" Foreground="{StaticResource SubtleText}" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</Window>

<Application x:Class="ChohyoPdf.Designer.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ChohyoPdf.Designer"
             xmlns:c="clr-namespace:ChohyoPdf.Designer.Controls"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <!-- 色と、標準のコントロールの形（ボタン・入力欄・コンボボックス・メニューなど） -->
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <local:NullableDoubleConverter x:Key="NullableDouble" />
            <local:SampleRowsConverter x:Key="SampleRows" />
            <local:EnumEqualsConverter x:Key="EnumEquals" />
            <local:NullToCollapsedConverter x:Key="NullToCollapsed" />
            <local:ZeroToVisibleConverter x:Key="ZeroToVisible" />
            <local:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility" />
            <local:CustomPaperVisibilityConverter x:Key="CustomPaperVisibility" />
            <local:FieldExampleConverter x:Key="FieldExample" />
            <local:FieldKindLabelConverter x:Key="FieldKindLabel" />
            <local:HasFormatVisibilityConverter x:Key="HasFormatVisibility" />
            <local:EnumVisibilityConverter x:Key="EnumVisibility" />
            <local:BracesConverter x:Key="Braces" />
            <local:UsageCountConverter x:Key="UsageCount" />
            <local:SameObjectConverter x:Key="SameObject" />
            <local:ColumnKindSummaryConverter x:Key="ColumnKindSummary" />
            <local:NotNullConverter x:Key="NotNull" />
            <local:ZoomSliderConverter x:Key="ZoomSlider" />
            <local:InverseBoolConverter x:Key="InverseBool" />
            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

            <!-- すべてのウィンドウの文字（App.OnStartup で、Window の既定のスタイルにする） -->
            <Style TargetType="Window">
                <Setter Property="FontFamily" Value="Yu Gothic UI, Segoe UI" />
                <Setter Property="FontSize" Value="12.5" />
                <Setter Property="Foreground" Value="{StaticResource NormalText}" />
                <Setter Property="UseLayoutRounding" Value="True" />
            </Style>

            <!-- ===== 設定欄（インスペクター・差し込みのウィンドウ） ===== -->

            <!-- 1 行（左に欄の名前、右に入力欄） -->
            <Style x:Key="PropRow" TargetType="DockPanel">
                <Setter Property="Margin" Value="0,3" />
                <Setter Property="LastChildFill" Value="True" />
            </Style>
            <Style x:Key="PropLabel" TargetType="TextBlock">
                <Setter Property="Width" Value="106" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Foreground" Value="{StaticResource SubtleText}" />
                <Setter Property="DockPanel.Dock" Value="Left" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            </Style>
            <!-- まとまりの見出し -->
            <Style x:Key="SectionHeader" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11.5" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Margin" Value="0,16,0,6" />
                <Setter Property="Foreground" Value="{StaticResource SubtleText}" />
            </Style>
            <Style x:Key="Hint" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource SubtleText}" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Margin" Value="0,4" />
                <Setter Property="FontSize" Value="11.5" />
                <Setter Property="LineHeight" Value="17" />
            </Style>
            <!-- アイコンの下の短い文字（表の操作のボタン） -->
            <Style x:Key="ToolCaption" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="Margin" Value="0,2,0,0" />
                <Setter Property="HorizontalAlignment" Value="Center" />
            </Style>

            <!-- アイコンの切り替えボタン（揃え・太字など）。選んでいるものは藍色にする -->
            <Style x:Key="IconToggle" TargetType="ToggleButton">
                <Setter Property="Width" Value="30" />
                <Setter Property="Height" Value="28" />
                <Setter Property="Margin" Value="0,0,2,0" />
                <Setter Property="Focusable" Value="False" />
                <Setter Property="Foreground" Value="{StaticResource NormalText}" />
                <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource ControlHover}" />
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentSoft}" />
                                    <Setter Property="Foreground" Value="{StaticResource AccentText}" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.35" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 枠のない平らなボタン（アイコンと短い文字。無効のときは薄く表示する） -->
            <Style x:Key="FlatButton" TargetType="Button">
                <Setter Property="Padding" Value="6,3" />
                <Setter Property="Margin" Value="1,0" />
                <Setter Property="Foreground" Value="{StaticResource NormalText}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource ControlHover}" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource ControlPressed}" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.35" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- アイコンだけのボタン（閉じる・コピーなど） -->
            <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource FlatButton}">
                <Setter Property="Padding" Value="5" />
                <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{StaticResource SubtleText}" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <!-- 主ボタン（藍色。1 つの画面に 1 つまで） -->
            <Style x:Key="PrimaryButton" TargetType="Button">
                <Setter Property="Foreground" Value="White" />
                <Setter Property="Background" Value="{StaticResource Accent}" />
                <Setter Property="Padding" Value="14,6" />
                <Setter Property="HorizontalAlignment" Value="Left" />
                <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{StaticResource AccentHover}" />
                    </Trigger>
                    <Trigger Property="IsPressed" Value="True">
                        <Setter Property="Background" Value="{StaticResource AccentPressed}" />
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Opacity" Value="0.45" />
                    </Trigger>
                </Style.Triggers>
            </Style>


            <!-- リンク風ボタン -->
            <Style x:Key="LinkButton" TargetType="Button">
                <Setter Property="Foreground" Value="{StaticResource LinkText}" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Padding" Value="2,1" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                                <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource LinkHover}" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.45" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- オンとオフを切り替えるスイッチ（CheckBox に付ける） -->
            <Style x:Key="ToggleSwitch" TargetType="CheckBox">
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Foreground" Value="{StaticResource NormalText}" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="CheckBox">
                            <DockPanel Background="Transparent">
                                <Grid DockPanel.Dock="Left" Width="34" Height="18" VerticalAlignment="Center">
                                    <Border x:Name="Track" CornerRadius="9" Background="#D4D4D8" />
                                    <Ellipse x:Name="Knob" Width="14" Height="14" Fill="White" HorizontalAlignment="Left" Margin="2,0,0,0" />
                                </Grid>
                                <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True" />
                            </DockPanel>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Track" Property="Background" Value="{StaticResource Accent}" />
                                    <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                                    <Setter TargetName="Knob" Property="Margin" Value="0,0,2,0" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.45" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 白いカード（角の丸い枠） -->
            <Style x:Key="Card" TargetType="Border">
                <Setter Property="Background" Value="White" />
                <Setter Property="BorderBrush" Value="{StaticResource PanelBorder}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Padding" Value="14" />
            </Style>

            <!-- コードチップ: {名前} を表す小さなラベル。Content には {} を付けた文字列を渡す -->
            <Style x:Key="CodeChip" TargetType="ContentControl">
                <Setter Property="Focusable" Value="False" />
                <Setter Property="IsTabStop" Value="False" />
                <Setter Property="HorizontalAlignment" Value="Left" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ContentControl">
                            <Border Background="{StaticResource ChipBackground}" BorderBrush="{StaticResource ChipBorder}" BorderThickness="1" CornerRadius="4" Padding="6,1,6,2">
                                <TextBlock Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}" FontFamily="{StaticResource CodeFont}" FontSize="12"
                                           Foreground="{StaticResource ChipText}" TextTrimming="CharacterEllipsis" />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 使用数の円 -->
            <Style TargetType="c:UsageBadge">
                <Setter Property="Width" Value="20" />
                <Setter Property="Height" Value="20" />
                <Setter Property="Focusable" Value="False" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="c:UsageBadge">
                            <Grid>
                                <Ellipse x:Name="Circle" Fill="#DCF5E6" Stroke="#9ADBB6" StrokeThickness="1" />
                                <TextBlock x:Name="Number" Text="{Binding Count, RelativeSource={RelativeSource TemplatedParent}}" FontSize="11" FontWeight="SemiBold"
                                           Foreground="#047857" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,1" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="Count" Value="0">
                                    <Setter TargetName="Circle" Property="Fill" Value="White" />
                                    <Setter TargetName="Circle" Property="Stroke" Value="#E0A35A" />
                                    <Setter TargetName="Circle" Property="StrokeDashArray" Value="2 1.5" />
                                    <Setter TargetName="Number" Property="Foreground" Value="#9A4A00" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>


            <!-- フォントの一覧の 1 行（設定により、名前と見本をそのフォントで表示する） -->
            <DataTemplate x:Key="FontItemTemplate">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Text="あア亜 Aa" Margin="12,0,0,0" Foreground="{StaticResource SubtleText}" c:FontFace.Name="{Binding}" />
                    <TextBlock Text="{Binding}" FontSize="13" c:FontFace.Name="{Binding}" />
                </DockPanel>
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>

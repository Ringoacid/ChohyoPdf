<Window x:Class="ChohyoPdf.Designer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:ChohyoPdf.Designer.Controls"
        xmlns:m="clr-namespace:ChohyoPdf.Designer.Model;assembly=ChohyoPdf.Designer.Core"
        xmlns:vm="clr-namespace:ChohyoPdf.Designer.ViewModels"
        Title="{Binding Title}" Width="1400" Height="900" MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen" Background="{StaticResource ChromeBackground}">

    <!-- タイトルバーも自分で描く（左にファイルのメニューと元に戻す、右にプレビューと出力） -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" ResizeBorderThickness="6" GlassFrameThickness="0,0,0,1" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- ===== タイトルバー ===== -->

        <!-- タイトルバーの平らなボタン（アイコンと、あれば文字） -->
        <Style x:Key="TopButton" TargetType="Button">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Foreground" Value="{StaticResource NormalText}" />
            <Setter Property="Height" Value="32" />
            <Setter Property="MinWidth" Value="32" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock x:Name="Glyph" Text="{Binding (c:CommandBar.Icon), RelativeSource={RelativeSource TemplatedParent}}" FontFamily="{StaticResource IconFont}"
                                           FontSize="15" VerticalAlignment="Center" />
                                <ContentPresenter x:Name="Label" VerticalAlignment="Center" Margin="7,0,0,0" />
                                <TextBlock x:Name="Arrow" Text="&#xE70D;" FontFamily="{StaticResource IconFont}" FontSize="8" VerticalAlignment="Center" Margin="6,1,0,0" Visibility="Collapsed" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Content" Value="{x:Null}">
                                <Setter TargetName="Label" Property="Visibility" Value="Collapsed" />
                            </Trigger>
                            <Trigger Property="c:CommandBar.Icon" Value="{x:Null}">
                                <Setter TargetName="Glyph" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="Label" Property="Margin" Value="0" />
                            </Trigger>
                            <Trigger Property="c:CommandBar.IsDropDown" Value="True">
                                <Setter TargetName="Arrow" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource ControlHover}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource ControlPressed}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TopToggle" TargetType="ToggleButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Foreground" Value="{StaticResource NormalText}" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="9,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{Binding (c:CommandBar.Icon), RelativeSource={RelativeSource TemplatedParent}}" FontFamily="{StaticResource IconFont}" FontSize="15" VerticalAlignment="Center" />
                                <ContentPresenter VerticalAlignment="Center" Margin="7,0,0,0" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource ControlHover}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentSoft}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentSoftBorder}" />
                                <Setter Property="Foreground" Value="{StaticResource AccentText}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CaptionButton" TargetType="Button">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Width" Value="46" />
            <Setter Property="Foreground" Value="{StaticResource NormalText}" />
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource ControlPressed}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CloseCaptionButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E5484D" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- タイトルバーの主ボタン（PDF を出力） -->
        <Style x:Key="TopPrimaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- ===== 左のツールのレール ===== -->
        <Style x:Key="RailTool" TargetType="ToggleButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Foreground" Value="#3F3F46" />
            <Setter Property="Width" Value="56" />
            <Setter Property="Height" Value="52" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="ToolTipService.Placement" Value="Right" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="8">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding (c:CommandBar.Icon), RelativeSource={RelativeSource TemplatedParent}}" FontSize="18" HorizontalAlignment="Center"
                                           FontFamily="{Binding (c:CommandBar.IconFont), RelativeSource={RelativeSource TemplatedParent}}" />
                                <ContentPresenter HorizontalAlignment="Center" Margin="0,4,0,0" TextElement.FontSize="10.5" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource ControlHover}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentSoft}" />
                                <Setter Property="Foreground" Value="{StaticResource AccentText}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="RailButton" TargetType="Button">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Foreground" Value="#3F3F46" />
            <Setter Property="Width" Value="56" />
            <Setter Property="Height" Value="52" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="ToolTipService.Placement" Value="Right" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="8">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding (c:CommandBar.Icon), RelativeSource={RelativeSource TemplatedParent}}" FontSize="16" HorizontalAlignment="Center"
                                           FontFamily="{Binding (c:CommandBar.IconFont), RelativeSource={RelativeSource TemplatedParent}}" />
                                <ContentPresenter HorizontalAlignment="Center" Margin="0,4,0,0" TextElement.FontSize="10.5" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource ControlHover}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource ControlPressed}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== 書式バー ===== -->

        <!-- 書式バーの、選んでいるものの名前（左端の札） -->
        <Style x:Key="ToolbarChip" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource ChromeBackground}" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="ToolbarSeparator" TargetType="Border">
            <Setter Property="Width" Value="1" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Margin" Value="7,0" />
            <Setter Property="Background" Value="{StaticResource PanelBorder}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <!-- 書式バーのボタン（アイコンと、あれば文字。▾ を付けると押したときにメニューを開く） -->
        <Style x:Key="BarButton" TargetType="Button">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Foreground" Value="{StaticResource NormalText}" />
            <Setter Property="Height" Value="28" />
            <Setter Property="MinWidth" Value="30" />
            <Setter Property="Padding" Value="7,0" />
            <Setter Property="Margin" Value="0,0,2,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <Grid x:Name="IconHost" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding (c:CommandBar.Icon), RelativeSource={RelativeSource TemplatedParent}}" FontSize="15" VerticalAlignment="Center" HorizontalAlignment="Center"
                                               FontFamily="{Binding (c:CommandBar.IconFont), RelativeSource={RelativeSource TemplatedParent}}"
                                               Foreground="{Binding (c:CommandBar.IconBrush), RelativeSource={RelativeSource TemplatedParent}, TargetNullValue={StaticResource NormalText}}" />
                                    <ContentPresenter Content="{Binding (c:CommandBar.IconElement), RelativeSource={RelativeSource TemplatedParent}}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                </Grid>
                                <ContentPresenter x:Name="Label" VerticalAlignment="Center" Margin="6,0,0,0" />
                                <TextBlock x:Name="Arrow" Text="&#xE70D;" FontFamily="{StaticResource IconFont}" FontSize="8" VerticalAlignment="Center" Margin="5,1,0,0" Visibility="Collapsed" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Content" Value="{x:Null}">
                                <Setter TargetName="Label" Property="Visibility" Value="Collapsed" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="c:CommandBar.Icon" Value="{x:Null}" />
                                    <Condition Property="c:CommandBar.IconElement" Value="{x:Null}" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="IconHost" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="Label" Property="Margin" Value="0" />
                            </MultiTrigger>
                            <Trigger Property="c:CommandBar.IsDropDown" Value="True">
                                <Setter TargetName="Arrow" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource ControlHover}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource ControlPressed}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- 書式バーの、押すと設定のパネルを開くボタン -->
        <Style x:Key="BarFlyout" TargetType="c:FlyoutButton">
            <Setter Property="Foreground" Value="{StaticResource NormalText}" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="7,0" />
            <Setter Property="Margin" Value="0,0,2,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="c:FlyoutButton">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{Binding (c:CommandBar.Icon), RelativeSource={RelativeSource TemplatedParent}}" FontFamily="{StaticResource IconFont}" FontSize="15" VerticalAlignment="Center" />
                                <ContentPresenter x:Name="Label" VerticalAlignment="Center" Margin="6,0,0,0" />
                                <TextBlock Text="&#xE70D;" FontFamily="{StaticResource IconFont}" FontSize="8" VerticalAlignment="Center" Margin="5,1,0,0" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Content" Value="{x:Null}">
                                <Setter TargetName="Label" Property="Visibility" Value="Collapsed" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource ControlHover}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentSoft}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- 書式バーの色のボタン -->
        <Style x:Key="BarColor" TargetType="c:ColorButton" BasedOn="{StaticResource IconToggle}">
            <Setter Property="Width" Value="Auto" />
            <Setter Property="Padding" Value="5,0" />
        </Style>
        <!-- 文字の飾り（太字・斜体・下線・取り消し線）のボタン -->
        <Style x:Key="DecorationToggle" TargetType="ToggleButton" BasedOn="{StaticResource IconToggle}">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontFamily" Value="Segoe UI" />
        </Style>
        <!-- 書式バーとパネルの中の小さな数値の欄 -->
        <Style x:Key="SmallNumber" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Width" Value="64" />
            <Setter Property="Padding" Value="6,3" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <!-- 設定のパネル（Flyout）の中の 1 行 -->
        <Style x:Key="FlyoutLabel" TargetType="TextBlock">
            <Setter Property="Width" Value="104" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{StaticResource SubtleText}" />
        </Style>
        <Style x:Key="FlyoutTitle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <!-- 書式バーの右端: 重なりの順序と削除（部品を選んでいるときはいつも出す） -->
        <DataTemplate x:Key="BarArrange">
            <StackPanel Orientation="Horizontal">
                <Border Style="{StaticResource ToolbarSeparator}" />
                <Button Style="{StaticResource BarButton}" c:CommandBar.Icon="&#xE81E;" c:CommandBar.IsDropDown="True" Content="重なり" ToolTip="手前・奥に移動">
                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="最前面へ移動" Command="{Binding BringToFrontCommand}" />
                            <MenuItem Header="前面へ移動" Command="{Binding BringForwardCommand}" />
                            <MenuItem Header="背面へ移動" Command="{Binding SendBackwardCommand}" />
                            <MenuItem Header="最背面へ移動" Command="{Binding SendToBackCommand}" />
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
                <Button Style="{StaticResource BarButton}" c:CommandBar.Icon="&#xE74D;" Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        ToolTip="削除 (Delete)" AutomationProperties.Name="部品を削除" />
            </StackPanel>
        </DataTemplate>

        <!-- 表の行と列の操作 -->
        <DataTemplate x:Key="BarTableOps">
            <StackPanel Orientation="Horizontal">
                <StackPanel.Resources>
                    <Style TargetType="Button" BasedOn="{StaticResource BarButton}">
                        <Setter Property="Command" Value="{Binding DataContext.TableCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                        <Setter Property="Padding" Value="4,0" />
                    </Style>
                </StackPanel.Resources>
                <Button CommandParameter="InsertRowAbove" ToolTip="上に行を挿入" AutomationProperties.Name="上に行を挿入"><c:CommandBar.IconElement><c:TableOperationIcon Operation="InsertRowAbove" /></c:CommandBar.IconElement></Button>
                <Button CommandParameter="InsertRowBelow" ToolTip="下に行を挿入" AutomationProperties.Name="下に行を挿入"><c:CommandBar.IconElement><c:TableOperationIcon Operation="InsertRowBelow" /></c:CommandBar.IconElement></Button>
                <Button CommandParameter="InsertColumnLeft" ToolTip="左に列を挿入" AutomationProperties.Name="左に列を挿入"><c:CommandBar.IconElement><c:TableOperationIcon Operation="InsertColumnLeft" /></c:CommandBar.IconElement></Button>
                <Button CommandParameter="InsertColumnRight" ToolTip="右に列を挿入" AutomationProperties.Name="右に列を挿入"><c:CommandBar.IconElement><c:TableOperationIcon Operation="InsertColumnRight" /></c:CommandBar.IconElement></Button>
                <Button c:CommandBar.IsDropDown="True" Command="{x:Null}" ToolTip="行か列を削除" AutomationProperties.Name="行か列を削除">
                    <c:CommandBar.IconElement><c:TableOperationIcon Operation="DeleteRow" /></c:CommandBar.IconElement>
                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="行を削除" Command="{Binding TableCommand}" CommandParameter="DeleteRow" />
                            <MenuItem Header="列を削除" Command="{Binding TableCommand}" CommandParameter="DeleteColumn" />
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
            </StackPanel>
        </DataTemplate>

        <!-- テキストの配置のパネル（縦の揃え・折り返し・行送りなど） -->
        <DataTemplate x:Key="TextLayoutFlyout">
            <StackPanel Width="250">
                <TextBlock Style="{StaticResource FlyoutTitle}" Text="テキストの配置" />
                <DockPanel Margin="0,2">
                    <TextBlock Style="{StaticResource FlyoutLabel}" Text="縦の揃え" />
                    <c:IconChoiceBar Choices="{x:Static c:Icons.VerticalAlignments}" SelectedValue="{Binding VerticalAlignment}" />
                </DockPanel>
                <CheckBox Content="枠の幅で折り返す" IsChecked="{Binding Wrap}" Margin="0,8,0,2" />
                <CheckBox Content="入りきらないときは縮小する" IsChecked="{Binding ShrinkToFit}" Margin="0,4,0,8" />
                <DockPanel Margin="0,3">
                    <TextBlock Style="{StaticResource FlyoutLabel}" Text="行送り（倍）" />
                    <TextBox Style="{StaticResource SmallNumber}" HorizontalAlignment="Left" Text="{Binding LineSpacing}" />
                </DockPanel>
                <DockPanel Margin="0,3">
                    <TextBlock Style="{StaticResource FlyoutLabel}" Text="字間（pt）" />
                    <TextBox Style="{StaticResource SmallNumber}" HorizontalAlignment="Left" Text="{Binding CharacterSpacing}" />
                </DockPanel>
                <DockPanel Margin="0,3">
                    <TextBlock Style="{StaticResource FlyoutLabel}" Text="内側の余白（mm）" />
                    <TextBox Style="{StaticResource SmallNumber}" HorizontalAlignment="Left" Text="{Binding Padding}" />
                </DockPanel>
            </StackPanel>
        </DataTemplate>

        <!-- 箇条書きのパネル（テキスト） -->
        <DataTemplate x:Key="TextListFlyout">
            <StackPanel Width="260">
                <TextBlock Style="{StaticResource FlyoutTitle}" Text="箇条書き" />
                <DockPanel Margin="0,3">
                    <TextBlock Style="{StaticResource FlyoutLabel}" Text="種類" />
                    <ComboBox ItemsSource="{x:Static vm:Choices.ListStyles}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding ListStyle}" AutomationProperties.Name="箇条書きの種類" />
                </DockPanel>
                <DockPanel Margin="0,3" Visibility="{Binding ListStyle, Converter={StaticResource EnumVisibility}, ConverterParameter=Bullet}">
                    <TextBlock Style="{StaticResource FlyoutLabel}" Text="記号" />
                    <ComboBox ItemsSource="{x:Static vm:Choices.Bullets}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Bullet, TargetNullValue=''}" AutomationProperties.Name="箇条書きの記号" />
                </DockPanel>
                <DockPanel Margin="0,3" Visibility="{Binding ListStyle, Converter={StaticResource EnumVisibility}, ConverterParameter=Numbered}">
                    <TextBlock Style="{StaticResource FlyoutLabel}" Text="番号" />
                    <ComboBox ItemsSource="{x:Static vm:Choices.NumberStyles}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding NumberStyle}" AutomationProperties.Name="番号の形" />
                </DockPanel>
                <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0" TextWrapping="Wrap"
                           Text="1 行が 1 項目になります。行の先頭に Tab を入れると、1 つ深い項目（入れ子）になります。" />
            </StackPanel>
        </DataTemplate>

        <!-- 上付き・下付き・ルビのボタン（テキストとセルの書式バー） -->
        <DataTemplate x:Key="BarMarkup">
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource BarButton}" Padding="4,0" Tag="sup" Click="Markup_Click" AutomationProperties.Name="上付き"
                        ToolTip="上付き。文字を編集中なら選んだ文字を、そうでなければ全体を上付きにします（もう一度押すと戻します）。&lt;sup&gt;2&lt;/sup&gt; と書いても同じです">
                    <c:CommandBar.IconElement>
                        <TextBlock FontFamily="Segoe UI" FontSize="14">x<Run Text="2" FontSize="9" BaselineAlignment="Superscript" /></TextBlock>
                    </c:CommandBar.IconElement>
                </Button>
                <Button Style="{StaticResource BarButton}" Padding="4,0" Tag="sub" Click="Markup_Click" AutomationProperties.Name="下付き"
                        ToolTip="下付き。文字を編集中なら選んだ文字を、そうでなければ全体を下付きにします（もう一度押すと戻します）。&lt;sub&gt;2&lt;/sub&gt; と書いても同じです">
                    <c:CommandBar.IconElement>
                        <TextBlock FontFamily="Segoe UI" FontSize="14">x<Run Text="2" FontSize="9" BaselineAlignment="Subscript" /></TextBlock>
                    </c:CommandBar.IconElement>
                </Button>
                <Button Style="{StaticResource BarButton}" Padding="4,0" Tag="ruby" Click="Markup_Click" AutomationProperties.Name="ルビ"
                        ToolTip="ルビ（振り仮名）。選んだ文字を ｜親文字《》 にして、《》 の中にルビを入力します。｜東京《とうきょう》 と書いても同じです">
                    <c:CommandBar.IconElement>
                        <TextBlock FontSize="11" Text="ルビ" />
                    </c:CommandBar.IconElement>
                </Button>
            </StackPanel>
        </DataTemplate>

        <!-- 線と塗りつぶしのパネル（矩形・楕円） -->
        <DataTemplate x:Key="ShapeStrokeFlyout">
            <StackPanel Width="240">
                <TextBlock Style="{StaticResource FlyoutTitle}" Text="枠線" />
                <DockPanel Margin="0,3">
                    <TextBlock Style="{StaticResource FlyoutLabel}" Text="太さ（pt）" />
                    <TextBox Style="{StaticResource SmallNumber}" HorizontalAlignment="Left" Text="{Binding StrokeWidth}" />
                </DockPanel>
                <DockPanel Margin="0,3">
                    <TextBlock Style="{StaticResource FlyoutLabel}" Text="線の種類" />
                    <ComboBox ItemsSource="{x:Static vm:Choices.DashStyles}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Dash}" />
                </DockPanel>
            </StackPanel>
        </DataTemplate>

        <!-- ===== 書式バーの中身（選んでいるものの種類ごと） ===== -->

        <DataTemplate x:Key="BarPage">
            <StackPanel Orientation="Horizontal">
                <Border Style="{StaticResource ToolbarChip}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE7C3;" FontFamily="{StaticResource IconFont}" FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="{Binding DataContext.PageText, RelativeSource={RelativeSource AncestorType=Window}}" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
                <Button Style="{StaticResource BarButton}" c:CommandBar.Icon="&#xE7C3;" c:CommandBar.IsDropDown="True" Click="PaperMenu_Click"
                        Content="{Binding DataContext.CurrentPaperLabel, RelativeSource={RelativeSource AncestorType=Window}}" ToolTip="このページの用紙の大きさと向き" AutomationProperties.Name="用紙" />
                <Border Style="{StaticResource ToolbarSeparator}" />
                <Button Style="{StaticResource BarButton}" c:CommandBar.Icon="&#xE710;" Content="新しいページ" Command="{Binding DataContext.AddPageCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        ToolTip="このページの後ろに、空のページを足します" />
                <Button Style="{StaticResource BarButton}" c:CommandBar.Icon="&#xE8A1;" Content="ヘッダーとフッター" Command="{Binding DataContext.EditCommonCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        ToolTip="すべてのページに描く部品（全ページ共通の部品）を編集します" />
                <Button Style="{StaticResource BarButton}" c:CommandBar.Icon="#" c:CommandBar.IconFont="Segoe UI" c:CommandBar.IsDropDown="True" Content="ページ番号" Click="InsertPageNumber_Click"
                        ToolTip="用紙の下の中央にページ番号を置きます（全ページ共通の部品になります。「1 / 3」「- 1 -」「i」「一」などの形を選べます）" />
                <TextBlock Text="部品を選ぶと、ここに書式が出ます" Foreground="{StaticResource MutedText}" VerticalAlignment="Center" Margin="16,0,0,0" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="BarCommon">
            <StackPanel Orientation="Horizontal">
                <Border Style="{StaticResource ToolbarChip}" Background="{StaticResource AccentSoft}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8A1;" FontFamily="{StaticResource IconFont}" FontSize="13" Foreground="{StaticResource AccentText}" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="全ページ共通の部品" Foreground="{StaticResource AccentText}" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
                <Button Style="{StaticResource BarButton}" c:CommandBar.Icon="#" c:CommandBar.IconFont="Segoe UI" c:CommandBar.IsDropDown="True" Content="ページ番号" Click="InsertPageNumber_Click"
                        ToolTip="用紙の下の中央にページ番号を置きます（「1 / 3」「- 1 -」「i」「一」などの形を選べます）" />
                <Button Style="{StaticResource BarButton}" c:CommandBar.Icon="&#xE787;" Content="日付" Click="InsertDate_Click" ToolTip="PDF を作った日（{今日}）を置きます" />
                <Button Style="{StaticResource BarButton}" c:CommandBar.Icon="{}{ }" c:CommandBar.IconFont="Consolas" c:CommandBar.IsDropDown="True" Content="差し込み欄" Click="InsertFieldMenu_Click"
                        ToolTip="差し込み欄 {名前} を書いたテキストを置きます" />
                <Border Style="{StaticResource ToolbarSeparator}" />
                <Button Style="{StaticResource PrimaryButton}" Focusable="False" Padding="12,4" VerticalAlignment="Center" Content="編集を終える"
                        Command="{Binding DataContext.EditCommonCommand, RelativeSource={RelativeSource AncestorType=Window}}" ToolTip="ページの編集に戻ります" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="BarMultiple">
            <StackPanel Orientation="Horizontal">
                <Border Style="{StaticResource ToolbarChip}">
                    <TextBlock Text="{Binding DataContext.SelectionSummary, RelativeSource={RelativeSource AncestorType=Window}}" VerticalAlignment="Center" />
                </Border>
                <StackPanel Orientation="Horizontal">
                    <StackPanel.Resources>
                        <Style TargetType="Button" BasedOn="{StaticResource BarButton}">
                            <Setter Property="Command" Value="{Binding DataContext.AlignCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                        </Style>
                        <Style TargetType="Path">
                            <Setter Property="Width" Value="16" />
                            <Setter Property="Height" Value="16" />
                            <Setter Property="Fill" Value="{StaticResource NormalText}" />
                        </Style>
                    </StackPanel.Resources>
                    <Button CommandParameter="Left" ToolTip="左揃え"><c:CommandBar.IconElement><Path Data="M1,1h1.5v14h-1.5z M4,3h10v3h-10z M4,9h6v3h-6z" /></c:CommandBar.IconElement></Button>
                    <Button CommandParameter="Center" ToolTip="左右中央揃え"><c:CommandBar.IconElement><Path Data="M7.25,1h1.5v14h-1.5z M2,3h12v3h-12z M4,9h8v3h-8z" /></c:CommandBar.IconElement></Button>
                    <Button CommandParameter="Right" ToolTip="右揃え"><c:CommandBar.IconElement><Path Data="M13.5,1h1.5v14h-1.5z M2,3h10v3h-10z M6,9h6v3h-6z" /></c:CommandBar.IconElement></Button>
                    <Border Style="{StaticResource ToolbarSeparator}" />
                    <Button CommandParameter="Top" ToolTip="上揃え"><c:CommandBar.IconElement><Path Data="M1,1h14v1.5h-14z M3,4h3v10h-3z M9,4h3v6h-3z" /></c:CommandBar.IconElement></Button>
                    <Button CommandParameter="Middle" ToolTip="上下中央揃え"><c:CommandBar.IconElement><Path Data="M1,7.25h14v1.5h-14z M3,2h3v12h-3z M9,4h3v8h-3z" /></c:CommandBar.IconElement></Button>
                    <Button CommandParameter="Bottom" ToolTip="下揃え"><c:CommandBar.IconElement><Path Data="M1,13.5h14v1.5h-14z M3,2h3v10h-3z M9,6h3v6h-3z" /></c:CommandBar.IconElement></Button>
                </StackPanel>
                <ContentPresenter ContentTemplate="{StaticResource BarArrange}" Content="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="BarText">
            <StackPanel Orientation="Horizontal">
                <Border Style="{StaticResource ToolbarChip}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8D2;" FontFamily="{StaticResource IconFont}" FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="テキスト" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
                <c:FontComboBox Width="150" VerticalAlignment="Center" FontName="{Binding FontName}" DefaultFontName="{Binding DataContext.Report.DefaultFontName, RelativeSource={RelativeSource AncestorType=Window}}"
                                ItemsSource="{Binding DataContext.FontNames, RelativeSource={RelativeSource AncestorType=Window}}" ToolTip="フォント（指定しなければ、文書の既定のフォント）" />
                <c:FontSizeBox Width="62" Margin="4,0,0,0" VerticalAlignment="Center" Value="{Binding FontSize}" ToolTip="文字の大きさ（ポイント）" />
                <Border Style="{StaticResource ToolbarSeparator}" />
                <ToggleButton Style="{StaticResource DecorationToggle}" IsChecked="{Binding Bold}" ToolTip="太字 (Ctrl+B)" FontWeight="Bold" Content="B" AutomationProperties.Name="太字" />
                <ToggleButton Style="{StaticResource DecorationToggle}" IsChecked="{Binding Italic}" ToolTip="斜体 (Ctrl+I)" FontStyle="Italic" Content="I" FontFamily="Times New Roman" AutomationProperties.Name="斜体" />
                <ToggleButton Style="{StaticResource DecorationToggle}" IsChecked="{Binding Underline}" ToolTip="下線" AutomationProperties.Name="下線">
                    <TextBlock Text="U" TextDecorations="Underline" />
                </ToggleButton>
                <ToggleButton Style="{StaticResource DecorationToggle}" IsChecked="{Binding Strikeout}" ToolTip="取り消し線" AutomationProperties.Name="取り消し線">
                    <TextBlock Text="abc" TextDecorations="Strikethrough" FontSize="12" />
                </ToggleButton>
                <ContentPresenter ContentTemplate="{StaticResource BarMarkup}" />
                <c:ColorButton Style="{StaticResource BarColor}" Glyph="&#xE8D3;" Color="{Binding Color}" AllowNone="False" ToolTip="文字の色" />
                <c:ColorButton Style="{StaticResource BarColor}" Glyph="&#xE7E6;" Color="{Binding BackgroundColor}" ToolTip="背景色（枠の中を塗る）" />
                <Border Style="{StaticResource ToolbarSeparator}" />
                <c:IconChoiceBar Choices="{x:Static c:Icons.Alignments}" SelectedValue="{Binding Alignment}" VerticalAlignment="Center" />
                <c:FlyoutButton Style="{StaticResource BarFlyout}" c:CommandBar.Icon="&#xE8FD;" ToolTip="箇条書き・番号付きの箇条書き" AutomationProperties.Name="箇条書き"
                                Flyout="{Binding}" FlyoutTemplate="{StaticResource TextListFlyout}" />
                <c:FlyoutButton Style="{StaticResource BarFlyout}" c:CommandBar.Icon="&#xE8C4;" ToolTip="縦の揃え・折り返し・行送りなど" AutomationProperties.Name="テキストの配置"
                                Flyout="{Binding}" FlyoutTemplate="{StaticResource TextLayoutFlyout}" />
                <ContentPresenter ContentTemplate="{StaticResource BarArrange}" Content="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="BarTable">
            <StackPanel Orientation="Horizontal">
                <Border Style="{StaticResource ToolbarChip}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE80A;" FontFamily="{StaticResource IconFont}" FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="表" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
                <c:FontComboBox Width="150" VerticalAlignment="Center" FontName="{Binding FontName}" DefaultFontName="{Binding DataContext.Report.DefaultFontName, RelativeSource={RelativeSource AncestorType=Window}}"
                                ItemsSource="{Binding DataContext.FontNames, RelativeSource={RelativeSource AncestorType=Window}}" ToolTip="表のフォント" />
                <c:FontSizeBox Width="62" Margin="4,0,0,0" VerticalAlignment="Center" Value="{Binding FontSize}" ToolTip="表の文字の大きさ（ポイント）" />
                <c:ColorButton Style="{StaticResource BarColor}" Margin="4,0,0,0" Glyph="&#xE8D3;" Color="{Binding Color}" AllowNone="False" ToolTip="表の文字の色" />
                <Border Style="{StaticResource ToolbarSeparator}" />
                <ContentPresenter ContentTemplate="{StaticResource BarTableOps}" />
                <Border Style="{StaticResource ToolbarSeparator}" />
                <c:FlyoutButton Style="{StaticResource BarFlyout}" c:CommandBar.Icon="&#xE70F;" Content="罫線" ToolTip="罫線・セルの余白・縦の揃え・1 行おきの色">
                    <c:FlyoutButton.Flyout>
                        <StackPanel Width="260">
                            <TextBlock Style="{StaticResource FlyoutTitle}" Text="罫線とセル" />
                            <DockPanel Margin="0,3">
                                <TextBlock Style="{StaticResource FlyoutLabel}" Text="罫線の色" />
                                <c:ColorBox Color="{Binding BorderColor}" />
                            </DockPanel>
                            <DockPanel Margin="0,3">
                                <TextBlock Style="{StaticResource FlyoutLabel}" Text="罫線の太さ（pt）" />
                                <TextBox Style="{StaticResource SmallNumber}" HorizontalAlignment="Left" Text="{Binding BorderWidth}" />
                            </DockPanel>
                            <DockPanel Margin="0,3">
                                <TextBlock Style="{StaticResource FlyoutLabel}" Text="セルの余白（mm）" />
                                <TextBox Style="{StaticResource SmallNumber}" HorizontalAlignment="Left" Text="{Binding CellPadding}" />
                            </DockPanel>
                            <DockPanel Margin="0,3">
                                <TextBlock Style="{StaticResource FlyoutLabel}" Text="縦の揃え" />
                                <c:IconChoiceBar Choices="{x:Static c:Icons.VerticalAlignments}" SelectedValue="{Binding VerticalAlignment}" />
                            </DockPanel>
                            <CheckBox Content="セルの中で折り返す" IsChecked="{Binding Wrap}" Margin="0,8,0,2" />
                            <CheckBox Content="入りきらないときは縮小する" IsChecked="{Binding ShrinkToFit}" Margin="0,4,0,8" />
                            <DockPanel Margin="0,3">
                                <TextBlock Style="{StaticResource FlyoutLabel}" Text="1 行おきの色" />
                                <c:ColorBox Color="{Binding AlternateRowColor}" ToolTip="くり返し行を 1 行おきに塗る色" />
                            </DockPanel>
                        </StackPanel>
                    </c:FlyoutButton.Flyout>
                </c:FlyoutButton>
                <TextBlock Text="くり返し" Foreground="{StaticResource SubtleText}" VerticalAlignment="Center" Margin="6,0,6,0" />
                <ComboBox Width="110" VerticalAlignment="Center" ItemsSource="{Binding DataContext.DetailSourceNames, RelativeSource={RelativeSource AncestorType=Window}}"
                          SelectedItem="{Binding DetailSource, TargetNullValue=''}"
                          ToolTip="一覧を選ぶと、表の下に緑色のくり返し行ができ、一覧の 1 件が 1 行として並びます（空欄ならくり返さない）" AutomationProperties.Name="くり返す一覧" />
                <ContentPresenter ContentTemplate="{StaticResource BarArrange}" Content="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="BarCell">
            <StackPanel Orientation="Horizontal">
                <Border Style="{StaticResource ToolbarChip}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE80A;" FontFamily="{StaticResource IconFont}" FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
                <c:FontSizeBox Width="62" VerticalAlignment="Center" Value="{Binding FontSize}" AllowEmpty="True" ToolTip="セルの文字の大きさ（空欄なら表の設定。フォントは表全体を選んで変えます）" />
                <ToggleButton Style="{StaticResource DecorationToggle}" Margin="4,0,2,0" IsChecked="{Binding Bold}" IsThreeState="True" FontWeight="Bold" Content="B"
                              ToolTip="太字 (Ctrl+B)（中間の状態は表の設定に従う）" AutomationProperties.Name="太字" />
                <ContentPresenter ContentTemplate="{StaticResource BarMarkup}" />
                <c:ColorButton Style="{StaticResource BarColor}" Glyph="&#xE8D3;" Color="{Binding Color}" ToolTip="セルの文字の色（「なし」なら表の設定）" />
                <c:ColorButton Style="{StaticResource BarColor}" Glyph="&#xE771;" Color="{Binding BackgroundColor}" ToolTip="セルの塗りつぶし" />
                <Border Style="{StaticResource ToolbarSeparator}" />
                <c:IconChoiceBar Choices="{x:Static c:Icons.Alignments}" SelectedValue="{Binding Alignment}" AllowNone="True" VerticalAlignment="Center"
                                 ToolTip="横の揃え（どれも選んでいなければ列の設定。もう一度押すと選択をやめます）" />
                <c:IconChoiceBar Choices="{x:Static c:Icons.VerticalAlignments}" SelectedValue="{Binding VerticalAlignment}" AllowNone="True" VerticalAlignment="Center" Margin="4,0,0,0"
                                 ToolTip="縦の揃え（どれも選んでいなければ表の設定）" />
                <Border Style="{StaticResource ToolbarSeparator}" />
                <ContentPresenter ContentTemplate="{StaticResource BarTableOps}" />
                <Button Style="{StaticResource BarButton}" Padding="4,0" Command="{Binding DataContext.TableCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="Merge"
                        ToolTip="セルを結合" AutomationProperties.Name="セルを結合"><c:CommandBar.IconElement><c:TableOperationIcon Operation="Merge" /></c:CommandBar.IconElement></Button>
                <Button Style="{StaticResource BarButton}" Padding="4,0" Command="{Binding DataContext.TableCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="Unmerge"
                        ToolTip="結合を解除" AutomationProperties.Name="結合を解除"><c:CommandBar.IconElement><c:TableOperationIcon Operation="Unmerge" /></c:CommandBar.IconElement></Button>
                <c:FlyoutButton Style="{StaticResource BarFlyout}" c:CommandBar.Icon="&#xE740;" ToolTip="行の高さ・列の幅・列の揃え" AutomationProperties.Name="セルの大きさ">
                    <c:FlyoutButton.Flyout>
                        <StackPanel Width="250">
                            <TextBlock Style="{StaticResource FlyoutTitle}" Text="行と列" />
                            <DockPanel Margin="0,3">
                                <TextBlock Style="{StaticResource FlyoutLabel}" Text="行の高さ（mm）" />
                                <TextBox Style="{StaticResource SmallNumber}" HorizontalAlignment="Left" Text="{Binding RowHeight, StringFormat=0.##}" />
                            </DockPanel>
                            <DockPanel Margin="0,3">
                                <TextBlock Style="{StaticResource FlyoutLabel}" Text="列の幅（mm）" />
                                <TextBox Style="{StaticResource SmallNumber}" HorizontalAlignment="Left" Text="{Binding ColumnWidth, StringFormat=0.##}" />
                            </DockPanel>
                            <DockPanel Margin="0,3">
                                <TextBlock Style="{StaticResource FlyoutLabel}" Text="列の揃え" />
                                <c:IconChoiceBar Choices="{x:Static c:Icons.Alignments}" SelectedValue="{Binding ColumnAlignment}" />
                            </DockPanel>
                        </StackPanel>
                    </c:FlyoutButton.Flyout>
                </c:FlyoutButton>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="BarShape">
            <StackPanel Orientation="Horizontal">
                <Border Style="{StaticResource ToolbarChip}">
                    <TextBlock Text="{Binding KindName}" VerticalAlignment="Center" />
                </Border>
                <c:ColorButton Style="{StaticResource BarColor}" Glyph="&#xE771;" Color="{Binding FillColor}" ToolTip="塗りつぶし" />
                <c:ColorButton Style="{StaticResource BarColor}" Glyph="&#xE70F;" Color="{Binding StrokeColor}" ToolTip="枠線の色（「なし」なら枠線を引かない）" />
                <c:FlyoutButton Style="{StaticResource BarFlyout}" c:CommandBar.Icon="&#xE14C;" ToolTip="枠線の太さと種類" AutomationProperties.Name="枠線"
                                Flyout="{Binding}" FlyoutTemplate="{StaticResource ShapeStrokeFlyout}" />
                <ContentPresenter ContentTemplate="{StaticResource BarArrange}" Content="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="BarLine">
            <StackPanel Orientation="Horizontal">
                <Border Style="{StaticResource ToolbarChip}">
                    <TextBlock Text="直線" VerticalAlignment="Center" />
                </Border>
                <c:ColorButton Style="{StaticResource BarColor}" Glyph="&#xE70F;" Color="{Binding StrokeColor}" AllowNone="False" ToolTip="線の色" />
                <TextBlock Text="太さ" Foreground="{StaticResource SubtleText}" VerticalAlignment="Center" Margin="8,0,6,0" />
                <TextBox Style="{StaticResource SmallNumber}" Width="52" Text="{Binding StrokeWidth}" ToolTip="線の太さ（pt）" />
                <ComboBox Width="76" Margin="6,0,0,0" VerticalAlignment="Center" ItemsSource="{x:Static vm:Choices.DashStyles}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Dash}" ToolTip="線の種類" />
                <ContentPresenter ContentTemplate="{StaticResource BarArrange}" Content="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="BarImage">
            <StackPanel Orientation="Horizontal">
                <Border Style="{StaticResource ToolbarChip}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE91B;" FontFamily="{StaticResource IconFont}" FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="画像" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
                <Button Style="{StaticResource BarButton}" c:CommandBar.Icon="&#xE8B9;" Content="画像を変更…" Command="{Binding DataContext.BrowseImageCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                <TextBlock Text="収め方" Foreground="{StaticResource SubtleText}" VerticalAlignment="Center" Margin="8,0,6,0" />
                <ComboBox Width="140" VerticalAlignment="Center" ItemsSource="{x:Static vm:Choices.ImageFits}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Fit}" />
                <ContentPresenter ContentTemplate="{StaticResource BarArrange}" Content="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}" />
            </StackPanel>
        </DataTemplate>

        <!-- ===== インスペクター（右の設定欄）: 部品ごとの設定 ===== -->

        <DataTemplate x:Key="CommonHeader">
            <StackPanel>
                <DockPanel Style="{StaticResource PropRow}">
                    <TextBlock Text="名前" Style="{StaticResource PropLabel}" />
                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" ToolTip="部品の一覧に出る名前" />
                </DockPanel>
                <!-- 全ページ共通の部品と、くり返し行のある表でページが増えるページの部品は、どのページに描くかを選べる -->
                <DockPanel Style="{StaticResource PropRow}"
                           Visibility="{Binding DataContext.ShowVisibilityOption, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{Binding DataContext.VisibilityLabel, RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource PropLabel}" />
                    <ComboBox ItemsSource="{Binding DataContext.VisibilityChoices, RelativeSource={RelativeSource AncestorType=Window}}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Visibility}"
                              ToolTip="全ページ共通の部品では、文書のどのページに描くかを選びます。ページの部品では、くり返し行のある表でページが増えたときに、増えたどのページに描くかを選びます" />
                </DockPanel>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="BoxPosition">
            <StackPanel>
                <TextBlock Text="位置と大きさ（mm）" Style="{StaticResource SectionHeader}" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="24" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="30" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="X" VerticalAlignment="Center" Foreground="{StaticResource SubtleText}" />
                    <TextBox Grid.Column="1" Text="{Binding X, StringFormat=0.##}" Margin="0,2" />
                    <TextBlock Grid.Column="3" Text="Y" VerticalAlignment="Center" Foreground="{StaticResource SubtleText}" />
                    <TextBox Grid.Column="4" Text="{Binding Y, StringFormat=0.##}" Margin="0,2" />
                    <TextBlock Grid.Row="1" Text="幅" VerticalAlignment="Center" Foreground="{StaticResource SubtleText}" />
                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Width, StringFormat=0.##}" Margin="0,2" />
                    <TextBlock Grid.Row="1" Grid.Column="3" Text="高さ" VerticalAlignment="Center" Foreground="{StaticResource SubtleText}" />
                    <TextBox Grid.Row="1" Grid.Column="4" Text="{Binding Height, StringFormat=0.##}" Margin="0,2" />
                </Grid>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="StrokeEditor">
            <StackPanel>
                <DockPanel Style="{StaticResource PropRow}">
                    <TextBlock Text="線の色" Style="{StaticResource PropLabel}" />
                    <c:ColorBox Color="{Binding StrokeColor}" AllowNone="True" />
                </DockPanel>
                <DockPanel Style="{StaticResource PropRow}">
                    <TextBlock Text="線の太さ（pt）" Style="{StaticResource PropLabel}" />
                    <TextBox Text="{Binding StrokeWidth}" />
                </DockPanel>
                <DockPanel Style="{StaticResource PropRow}">
                    <TextBlock Text="線の種類" Style="{StaticResource PropLabel}" />
                    <ComboBox ItemsSource="{x:Static vm:Choices.DashStyles}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Dash}" />
                </DockPanel>
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type m:TextElement}">
            <StackPanel>
                <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource CommonHeader}" />
                <TextBlock Text="文字" Style="{StaticResource SectionHeader}" />
                <TextBox x:Name="TextEditor" Tag="TextEditor" Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap"
                         c:ListMarkerDisplay.Element="{Binding}"
                         MinHeight="72" MaxHeight="220" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto"
                         ToolTip="用紙の上でダブルクリックしても編集できます。{名前} と書いた所には、差し込み項目の値が入ります" />
                <ComboBox Margin="0,6,0,0" ItemsSource="{Binding DataContext.InsertableNames, RelativeSource={RelativeSource AncestorType=Window}}"
                          Tag="{Binding ElementName=TextEditor}" SelectionChanged="InsertField_SelectionChanged" ToolTip="カーソルの位置に差し込み欄 {名前} を入れます"
                          Text="差し込み欄を挿入…" IsEditable="True" IsReadOnly="True" />
                <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0" TextWrapping="Wrap"
                           Text="文字の一部は、上付き &lt;sup&gt;2&lt;/sup&gt;、下付き &lt;sub&gt;2&lt;/sub&gt;、ルビ ｜東京《とうきょう》 と書けます（書式バーの x²・x₂・ルビのボタンでも入ります）。" />
                <TextBlock Text="箇条書き" Style="{StaticResource SectionHeader}" />
                <DockPanel Style="{StaticResource PropRow}">
                    <TextBlock Text="種類" Style="{StaticResource PropLabel}" />
                    <ComboBox ItemsSource="{x:Static vm:Choices.ListStyles}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding ListStyle}" AutomationProperties.Name="箇条書きの種類" />
                </DockPanel>
                <DockPanel Style="{StaticResource PropRow}" Visibility="{Binding ListStyle, Converter={StaticResource EnumVisibility}, ConverterParameter=Bullet}">
                    <TextBlock Text="記号" Style="{StaticResource PropLabel}" />
                    <ComboBox ItemsSource="{x:Static vm:Choices.Bullets}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Bullet, TargetNullValue=''}" AutomationProperties.Name="箇条書きの記号" />
                </DockPanel>
                <DockPanel Style="{StaticResource PropRow}" Visibility="{Binding ListStyle, Converter={StaticResource EnumVisibility}, ConverterParameter=Numbered}">
                    <TextBlock Text="番号" Style="{StaticResource PropLabel}" />
                    <ComboBox ItemsSource="{x:Static vm:Choices.NumberStyles}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding NumberStyle}" AutomationProperties.Name="番号の形" />
                </DockPanel>
                <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0" TextWrapping="Wrap"
                           Text="箇条書きにすると、1 行が 1 項目になります。行の先頭に Tab を入れると入れ子になります。" />
                <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource BoxPosition}" />

                <TextBlock Text="枠と背景" Style="{StaticResource SectionHeader}" />
                <DockPanel Style="{StaticResource PropRow}">
                    <TextBlock Text="背景色" Style="{StaticResource PropLabel}" />
                    <c:ColorBox Color="{Binding BackgroundColor}" />
                </DockPanel>
                <DockPanel Style="{StaticResource PropRow}">
                    <TextBlock Text="枠線の色" Style="{StaticResource PropLabel}" />
                    <c:ColorBox Color="{Binding BorderColor}" />
                </DockPanel>
                <DockPanel Style="{StaticResource PropRow}">
                    <TextBlock Text="枠線の太さ（pt）" Style="{StaticResource PropLabel}" />
                    <TextBox Text="{Binding BorderWidth}" />
                </DockPanel>
                <DockPanel Style="{StaticResource PropRow}">
                    <TextBlock Text="枠線の種類" Style="{StaticResource PropLabel}" />
                    <ComboBox ItemsSource="{x:Static vm:Choices.DashStyles}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding BorderDash}" />
                </DockPanel>
                <DockPanel Style="{StaticResource PropRow}">
                    <TextBlock Text="余白（mm）" Style="{StaticResource PropLabel}" ToolTip="枠と文字の間の余白" />
                    <TextBox Text="{Binding Padding}" />
                </DockPanel>

                <TextBlock Text="文字の配置" Style="{StaticResource SectionHeader}" />
                <DockPanel Style="{StaticResource PropRow}">
                    <TextBlock Text="行送り（倍）" Style="{StaticResource PropLabel}" />
                    <TextBox Text="{Binding LineSpacing}" />
                </DockPanel>
                <DockPanel Style="{StaticResource PropRow}">
                    <TextBlock Text="字間（pt）" Style="{StaticResource PropLabel}" />
                    <TextBox Text="{Binding CharacterSpacing}" />
                </DockPanel>
                <CheckBox Content="枠の幅で折り返す" IsChecked="{Binding Wrap}" Margin="0,6,0,2" />
                <CheckBox Content="入りきらないときは縮小する" IsChecked="{Binding ShrinkToFit}" />
                <TextBlock Style="{StaticResource Hint}" Margin="0,10,0,0" Text="フォント・大きさ・色・揃えは、上の書式バーで変えます。" />

                <TextBlock Text="タブ位置" Style="{StaticResource SectionHeader}" />
                <ItemsControl ItemsSource="{Binding TabStops}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,2,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="56" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="4" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding Position, StringFormat=0.##}" ToolTip="位置（mm）。文字を置く範囲の左端から測ります" AutomationProperties.Name="タブ位置（mm）" />
                                <ComboBox Grid.Column="1" Margin="4,0,0,0" ItemsSource="{x:Static vm:Choices.TabAlignments}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Alignment}"
                                          AutomationProperties.Name="タブ位置での揃え" />
                                <ComboBox Grid.Column="3" ItemsSource="{x:Static vm:Choices.TabLeaders}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Leader}"
                                          ToolTip="リーダー（タブで空いた所を埋める線）" AutomationProperties.Name="リーダー" />
                                <Button Grid.Column="4" Style="{StaticResource IconButton}" Content="&#xE711;" FontSize="9" Padding="6,4" Margin="2,0,0,0" ToolTip="このタブ位置を削除"
                                        Command="{Binding DataContext.RemoveTabStopCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button HorizontalAlignment="Left" Margin="0,4,0,0" Command="{Binding DataContext.AddTabStopCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" FontSize="10" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="タブ位置を追加" />
                    </StackPanel>
                </Button>
                <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0" TextWrapping="Wrap"
                           Text="文字の途中の Tab は、次のタブ位置まで進みます（品名……金額 のように、点線でつなげます）。位置は mm で、文字を置く範囲の左端から測ります。箇条書きでは、行頭の Tab は入れ子、行の途中の Tab がタブ位置です。" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type m:LineElement}">
            <StackPanel>
                <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource CommonHeader}" />
                <TextBlock Text="位置（mm）" Style="{StaticResource SectionHeader}" />
                <Grid ToolTip="端のハンドルを Shift キーを押しながらドラッグすると、水平・垂直・45 度に揃えます">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="44" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="44" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="始点 X" VerticalAlignment="Center" Foreground="{StaticResource SubtleText}" />
                    <TextBox Grid.Column="1" Text="{Binding X1, StringFormat=0.##}" Margin="0,2" />
                    <TextBlock Grid.Column="3" Text="始点 Y" VerticalAlignment="Center" Foreground="{StaticResource SubtleText}" />
                    <TextBox Grid.Column="4" Text="{Binding Y1, StringFormat=0.##}" Margin="0,2" />
                    <TextBlock Grid.Row="1" Text="終点 X" VerticalAlignment="Center" Foreground="{StaticResource SubtleText}" />
                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding X2, StringFormat=0.##}" Margin="0,2" />
                    <TextBlock Grid.Row="1" Grid.Column="3" Text="終点 Y" VerticalAlignment="Center" Foreground="{StaticResource SubtleText}" />
                    <TextBox Grid.Row="1" Grid.Column="4" Text="{Binding Y2, StringFormat=0.##}" Margin="0,2" />
                </Grid>
                <TextBlock Text="線" Style="{StaticResource SectionHeader}" />
                <DockPanel Style="{StaticResource PropRow}">
                    <TextBlock Text="線の色" Style="{StaticResource PropLabel}" />
                    <c:ColorBox Color="{Binding StrokeColor}" AllowNone="False" />
                </DockPanel>
                <DockPanel Style="{StaticResource PropRow}">
                    <TextBlock Text="線の太さ（pt）" Style="{StaticResource PropLabel}" />
                    <TextBox Text="{Binding StrokeWidth}" />
                </DockPanel>
                <DockPanel Style="{StaticResource PropRow}">
                    <TextBlock Text="線の種類" Style="{StaticResource PropLabel}" />
                    <ComboBox ItemsSource="{x:Static vm:Choices.DashStyles}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Dash}" />
                </DockPanel>
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type m:RectangleElement}">
            <StackPanel>
                <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource CommonHeader}" />
                <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource BoxPosition}" />
                <TextBlock Text="線と塗りつぶし" Style="{StaticResource SectionHeader}" />
                <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource StrokeEditor}" />
                <DockPanel Style="{StaticResource PropRow}">
                    <TextBlock Text="塗りつぶし" Style="{StaticResource PropLabel}" />
                    <c:ColorBox Color="{Binding FillColor}" />
                </DockPanel>
                <DockPanel Style="{StaticResource PropRow}">
                    <TextBlock Text="角の半径（mm）" Style="{StaticResource PropLabel}" />
                    <TextBox Text="{Binding CornerRadius}" />
                </DockPanel>
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type m:EllipseElement}">
            <StackPanel>
                <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource CommonHeader}" />
                <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource BoxPosition}" />
                <TextBlock Text="線と塗りつぶし" Style="{StaticResource SectionHeader}" />
                <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource StrokeEditor}" />
                <DockPanel Style="{StaticResource PropRow}">
                    <TextBlock Text="塗りつぶし" Style="{StaticResource PropLabel}" />
                    <c:ColorBox Color="{Binding FillColor}" />
                </DockPanel>
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type m:ImageElement}">
            <StackPanel>
                <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource CommonHeader}" />
                <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource BoxPosition}" />
                <TextBlock Text="画像" Style="{StaticResource SectionHeader}" />
                <DockPanel Style="{StaticResource PropRow}">
                    <TextBlock Text="ファイル" Style="{StaticResource PropLabel}" />
                    <Button DockPanel.Dock="Right" Content="参照…" Margin="4,0,0,0" Padding="10,4" Command="{Binding DataContext.BrowseImageCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                    <TextBox Text="{Binding Path}" ToolTip="保存したデザインでは、デザインファイルのフォルダからの相対パスで記録します。出力した C# コードでは ImageFolder のフォルダから探します" />
                </DockPanel>
                <DockPanel Style="{StaticResource PropRow}">
                    <TextBlock Text="収め方" Style="{StaticResource PropLabel}" />
                    <ComboBox ItemsSource="{x:Static vm:Choices.ImageFits}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Fit}" />
                </DockPanel>
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:CellEditor}">
            <StackPanel>
                <TextBlock Style="{StaticResource SectionHeader}" Margin="0,4,0,6">
                    <Run Text="選んだセル：" /><Run Text="{Binding Title, Mode=OneWay}" />
                </TextBlock>
                <TextBox x:Name="CellTextEditor" Tag="CellTextEditor" Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap"
                         MinHeight="52" MaxHeight="160" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" />
                <ComboBox Margin="0,6,0,0" ItemsSource="{Binding DataContext.InsertableNames, RelativeSource={RelativeSource AncestorType=Window}}"
                          Tag="{Binding ElementName=CellTextEditor}" SelectionChanged="InsertField_SelectionChanged" Text="差し込み欄を挿入…" IsEditable="True" IsReadOnly="True" />
                <TextBlock Style="{StaticResource Hint}" Visibility="{Binding IsDetailRow, Converter={StaticResource BoolToVisibility}}"
                           Text="くり返し行には、一覧の列を {列名} で差し込みます。この行が、一覧の件数だけくり返されます。" />
                <DockPanel Style="{StaticResource PropRow}" Margin="0,8,0,3">
                    <TextBlock Text="行の高さ（mm）" Style="{StaticResource PropLabel}" />
                    <TextBox Text="{Binding RowHeight, StringFormat=0.##}" />
                </DockPanel>
                <DockPanel Style="{StaticResource PropRow}">
                    <TextBlock Text="列の幅（mm）" Style="{StaticResource PropLabel}" />
                    <TextBox Text="{Binding ColumnWidth, StringFormat=0.##}" />
                </DockPanel>
                <DockPanel Style="{StaticResource PropRow}">
                    <TextBlock Text="列の揃え" Style="{StaticResource PropLabel}" />
                    <c:IconChoiceBar Choices="{x:Static c:Icons.Alignments}" SelectedValue="{Binding ColumnAlignment}" />
                </DockPanel>
            </StackPanel>
        </DataTemplate>

        <!-- 表の操作のボタン（アイコンと短い名前） -->
        <Style x:Key="TableOpButton" TargetType="Button" BasedOn="{StaticResource FlatButton}">
            <Setter Property="Width" Value="58" />
            <Setter Property="Padding" Value="2,5" />
            <Setter Property="Command" Value="{Binding DataContext.TableCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
        </Style>

        <DataTemplate DataType="{x:Type m:TableElement}">
            <StackPanel>
                <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource CommonHeader}" />
                <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource BoxPosition}" />
                <TextBlock Style="{StaticResource Hint}" Text="表の中をクリックするとセルを選べます。表を動かすには、左上のつまみか枠線をドラッグします。" />

                <Border Margin="0,10,0,0" Padding="12,4,12,10" Background="{StaticResource HeaderBackground}" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" CornerRadius="8"
                        Visibility="{Binding DataContext.CellEditor, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource NullToCollapsed}}">
                    <ContentPresenter Content="{Binding DataContext.CellEditor, RelativeSource={RelativeSource AncestorType=Window}}" />
                </Border>

                <TextBlock Text="行と列" Style="{StaticResource SectionHeader}" />
                <WrapPanel>
                    <Button Style="{StaticResource TableOpButton}" CommandParameter="InsertRowAbove" ToolTip="選んでいるセルの上に行を挿入">
                        <StackPanel><c:TableOperationIcon Operation="InsertRowAbove" /><TextBlock Style="{StaticResource ToolCaption}" Text="上に行" /></StackPanel>
                    </Button>
                    <Button Style="{StaticResource TableOpButton}" CommandParameter="InsertRowBelow" ToolTip="選んでいるセルの下に行を挿入">
                        <StackPanel><c:TableOperationIcon Operation="InsertRowBelow" /><TextBlock Style="{StaticResource ToolCaption}" Text="下に行" /></StackPanel>
                    </Button>
                    <Button Style="{StaticResource TableOpButton}" CommandParameter="InsertColumnLeft" ToolTip="選んでいるセルの左に列を挿入">
                        <StackPanel><c:TableOperationIcon Operation="InsertColumnLeft" /><TextBlock Style="{StaticResource ToolCaption}" Text="左に列" /></StackPanel>
                    </Button>
                    <Button Style="{StaticResource TableOpButton}" CommandParameter="InsertColumnRight" ToolTip="選んでいるセルの右に列を挿入">
                        <StackPanel><c:TableOperationIcon Operation="InsertColumnRight" /><TextBlock Style="{StaticResource ToolCaption}" Text="右に列" /></StackPanel>
                    </Button>
                    <Button Style="{StaticResource TableOpButton}" CommandParameter="DeleteRow" ToolTip="選んでいる行を削除">
                        <StackPanel><c:TableOperationIcon Operation="DeleteRow" /><TextBlock Style="{StaticResource ToolCaption}" Text="行を削除" /></StackPanel>
                    </Button>
                    <Button Style="{StaticResource TableOpButton}" CommandParameter="DeleteColumn" ToolTip="選んでいる列を削除">
                        <StackPanel><c:TableOperationIcon Operation="DeleteColumn" /><TextBlock Style="{StaticResource ToolCaption}" Text="列を削除" /></StackPanel>
                    </Button>
                    <Button Style="{StaticResource TableOpButton}" CommandParameter="Merge" ToolTip="選んでいるセルを 1 つに結合">
                        <StackPanel><c:TableOperationIcon Operation="Merge" /><TextBlock Style="{StaticResource ToolCaption}" Text="結合" /></StackPanel>
                    </Button>
                    <Button Style="{StaticResource TableOpButton}" CommandParameter="Unmerge" ToolTip="セルの結合を解除">
                        <StackPanel><c:TableOperationIcon Operation="Unmerge" /><TextBlock Style="{StaticResource ToolCaption}" Text="結合を解除" /></StackPanel>
                    </Button>
                </WrapPanel>

                <TextBlock Text="くり返し行" Style="{StaticResource SectionHeader}" />
                <DockPanel Style="{StaticResource PropRow}">
                    <TextBlock Text="くり返す一覧" Style="{StaticResource PropLabel}" />
                    <ComboBox ItemsSource="{Binding DataContext.DetailSourceNames, RelativeSource={RelativeSource AncestorType=Window}}"
                              SelectedItem="{Binding DetailSource, TargetNullValue=''}" ToolTip="空欄なら、行をくり返さない普通の表です" />
                </DockPanel>
                <DockPanel Style="{StaticResource PropRow}">
                    <TextBlock Text="1 ページの行数" Style="{StaticResource PropLabel}" />
                    <TextBox Text="{Binding DetailRowCount}" ToolTip="件数がこれを超えると、ページを増やして続きを描きます" />
                </DockPanel>
                <DockPanel Style="{StaticResource PropRow}">
                    <TextBlock Text="1 行おきの色" Style="{StaticResource PropLabel}" />
                    <c:ColorBox Color="{Binding AlternateRowColor}" />
                </DockPanel>
                <TextBlock Style="{StaticResource Hint}" Text="一覧は、タイトルバーの「差し込み」で作ります。くり返し行のセルに {列名} と書くと、一覧の 1 件が 1 行として並びます。" />

                <TextBlock Text="罫線とセル" Style="{StaticResource SectionHeader}" />
                <DockPanel Style="{StaticResource PropRow}">
                    <TextBlock Text="罫線の色" Style="{StaticResource PropLabel}" />
                    <c:ColorBox Color="{Binding BorderColor}" />
                </DockPanel>
                <DockPanel Style="{StaticResource PropRow}">
                    <TextBlock Text="罫線の太さ（pt）" Style="{StaticResource PropLabel}" />
                    <TextBox Text="{Binding BorderWidth}" />
                </DockPanel>
                <DockPanel Style="{StaticResource PropRow}">
                    <TextBlock Text="セルの余白（mm）" Style="{StaticResource PropLabel}" />
                    <TextBox Text="{Binding CellPadding}" />
                </DockPanel>
                <DockPanel Style="{StaticResource PropRow}">
                    <TextBlock Text="縦の揃え" Style="{StaticResource PropLabel}" />
                    <c:IconChoiceBar Choices="{x:Static c:Icons.VerticalAlignments}" SelectedValue="{Binding VerticalAlignment}" />
                </DockPanel>
                <CheckBox Content="セルの中で折り返す" IsChecked="{Binding Wrap}" Margin="0,6,0,2" />
                <CheckBox Content="入りきらないときは縮小する" IsChecked="{Binding ShrinkToFit}" />
            </StackPanel>
        </DataTemplate>

        <!-- ナビゲーション（左のパネル）のページの縮小画像（選んでいるページは藍色の枠） -->
        <Style x:Key="PageThumbItem" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="8" Padding="8,8,8,6" Margin="2,2">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource ControlHover}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentSoft}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 「全ページ共通の部品」のカード（ページの一覧の上） -->
        <Style x:Key="CommonCard" TargetType="ToggleButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" Background="White" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" CornerRadius="8" Padding="10,8">
                            <DockPanel>
                                <Border DockPanel.Dock="Left" Width="28" Height="28" CornerRadius="6" Background="{StaticResource AccentSoft}" VerticalAlignment="Center">
                                    <TextBlock Text="&#xE8A1;" FontFamily="{StaticResource IconFont}" FontSize="14" Foreground="{StaticResource AccentText}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="全ページ共通の部品" FontWeight="SemiBold" />
                                    <TextBlock Text="ヘッダー・フッター・ページ番号" FontSize="11" Foreground="{StaticResource SubtleText}" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource RowHover}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentSoft}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentSoftBorder}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PaneTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <!-- ステータスバーの平らなボタン -->
        <Style x:Key="StatusButton" TargetType="Button" BasedOn="{StaticResource FlatButton}">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="MinWidth" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Foreground" Value="#3F3F46" />
        </Style>
    </Window.Resources>

    <Border x:Name="RootBorder">
        <DockPanel>
            <!-- ===== タイトルバー ===== -->
            <Border DockPanel.Dock="Top" Height="44" Background="White">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="12,0,0,0">
                        <!-- アプリのしるし（用紙と、差し込み欄の括弧） -->
                        <Border Width="24" Height="24" CornerRadius="6" Background="{StaticResource Accent}" VerticalAlignment="Center" Margin="0,0,10,0">
                            <TextBlock Text="{}{ }" FontFamily="Consolas" FontWeight="Bold" FontSize="11" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,1" />
                        </Border>
                        <Button x:Name="FileButton" Style="{StaticResource TopButton}" Content="ファイル" c:CommandBar.IsDropDown="False" Click="FileMenu_Click" AutomationProperties.Name="ファイル">
                            <Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="新規作成(_N)" Command="{Binding NewCommand}" InputGestureText="Ctrl+N" />
                                    <MenuItem Header="見本から新規作成(_M)">
                                        <MenuItem Header="案内状（宛名を差し込む手紙）" Command="{Binding NewSampleCommand}" CommandParameter="Letter" />
                                        <MenuItem Header="活動報告書（表紙・本文・名簿の 3 ページ）" Command="{Binding NewSampleCommand}" CommandParameter="Document" />
                                        <MenuItem Header="請求書（品目をくり返す表）" Command="{Binding NewSampleCommand}" CommandParameter="Invoice" />
                                    </MenuItem>
                                    <MenuItem Header="開く(_O)…" Command="{Binding OpenCommand}" InputGestureText="Ctrl+O" />
                                    <Separator />
                                    <MenuItem Header="上書き保存(_S)" Command="{Binding SaveCommand}" InputGestureText="Ctrl+S" />
                                    <MenuItem Header="名前を付けて保存(_A)…" Command="{Binding SaveAsCommand}" InputGestureText="Ctrl+Shift+S" />
                                    <Separator />
                                    <MenuItem Header="プレビュー(_P)" Click="Preview_Click" InputGestureText="F5" />
                                    <MenuItem Header="PDF を出力(_E)…" Command="{Binding ExportPdfCommand}" InputGestureText="Ctrl+E" />
                                    <MenuItem Header="C# コードを出力(_C)…" Click="ExportCode_Click" InputGestureText="Ctrl+G" />
                                    <Separator />
                                    <MenuItem Header="オプション(_T)…" Click="Options_Click" />
                                    <Separator />
                                    <MenuItem Header="終了(_X)" Click="Exit_Click" />
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                        <Border Width="1" Height="20" Background="{StaticResource PanelBorder}" Margin="6,0" VerticalAlignment="Center" />
                        <Button Style="{StaticResource TopButton}" c:CommandBar.Icon="&#xE7A7;" Command="{Binding UndoCommand}" ToolTip="元に戻す (Ctrl+Z)" AutomationProperties.Name="元に戻す" />
                        <Button Style="{StaticResource TopButton}" c:CommandBar.Icon="&#xE7A6;" Command="{Binding RedoCommand}" ToolTip="やり直し (Ctrl+Y)" AutomationProperties.Name="やり直し" />
                        <Button Style="{StaticResource TopButton}" c:CommandBar.Icon="&#xE74E;" Command="{Binding SaveCommand}" ToolTip="上書き保存 (Ctrl+S)" AutomationProperties.Name="上書き保存" />
                    </StackPanel>

                    <!-- 中央: 文書の名前（変更があれば点を付ける）。左右のボタンの間に置き、入りきらなければ省略する -->
                    <DockPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="12,0" IsHitTestVisible="False">
                        <Ellipse DockPanel.Dock="Right" Width="6" Height="6" Fill="{StaticResource Accent}" Margin="7,1,0,0" VerticalAlignment="Center"
                                 Visibility="{Binding IsDirty, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock Text="{Binding DocumentName}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="320" />
                    </DockPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button Style="{StaticResource TopButton}" c:CommandBar.Icon="&#xE9D5;" Click="OpenMerge_Click" AutomationProperties.Name="差し込みの設定"
                                ToolTip="宛名や日付のように、PDF ごとに変わる文字（差し込み項目と一覧）を設定します">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="差し込み" VerticalAlignment="Center" />
                                <Border CornerRadius="8" Background="{StaticResource AccentSoft}" Padding="6,0,6,1" Margin="6,0,0,0" VerticalAlignment="Center"
                                        Visibility="{Binding HasDataDefinitions, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="{Binding DataDefinitionCount}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AccentText}" />
                                </Border>
                            </StackPanel>
                        </Button>
                        <ToggleButton Style="{StaticResource TopToggle}" c:CommandBar.Icon="&#xE890;" Content="結果を表示" IsChecked="{Binding ShowSampleValues}" Margin="2,0,0,0"
                                      ToolTip="差し込み欄に確認用の値を入れて、用紙に表示します" AutomationProperties.Name="差し込み結果を表示" />
                        <Border Width="1" Height="20" Background="{StaticResource PanelBorder}" Margin="8,0" VerticalAlignment="Center" />
                        <Button Style="{StaticResource TopButton}" c:CommandBar.Icon="&#xE8FF;" Content="プレビュー" Click="Preview_Click" ToolTip="確認用の値を差し込んだ PDF を表示します (F5)" />
                        <Button Style="{StaticResource TopPrimaryButton}" Margin="6,0,0,0" Command="{Binding ExportPdfCommand}" ToolTip="PDF を出力 (Ctrl+E)">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xEA90;" FontFamily="{StaticResource IconFont}" FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBlock Text="PDF を出力" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource TopButton}" c:CommandBar.Icon="&#xE70D;" Margin="2,0,8,0" Click="ExportMenu_Click" ToolTip="そのほかの出力（C# コード）" AutomationProperties.Name="そのほかの出力" />
                        <Button Style="{StaticResource CaptionButton}" Content="&#xE921;" Click="Minimize_Click" ToolTip="最小化" AutomationProperties.Name="最小化" />
                        <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButton}" Content="&#xE922;" Click="Maximize_Click" ToolTip="最大化" AutomationProperties.Name="最大化" />
                        <Button Style="{StaticResource CloseCaptionButton}" Content="&#xE8BB;" Click="Exit_Click" ToolTip="閉じる" AutomationProperties.Name="閉じる" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ===== 書式バー（選んでいるものに合わせて中身が変わる） ===== -->
            <Border DockPanel.Dock="Top" Height="48" Background="White" BorderBrush="{StaticResource PanelBorder}" BorderThickness="0,1,0,1" Padding="12,0" ClipToBounds="True">
                <ContentControl x:Name="ToolbarHost" Content="{Binding ToolbarTarget}" Focusable="False" VerticalAlignment="Center">
                    <ContentControl.Resources>
                        <DataTemplate DataType="{x:Type vm:PageToolbar}"><ContentPresenter ContentTemplate="{StaticResource BarPage}" /></DataTemplate>
                        <DataTemplate DataType="{x:Type vm:CommonToolbar}"><ContentPresenter ContentTemplate="{StaticResource BarCommon}" /></DataTemplate>
                        <DataTemplate DataType="{x:Type vm:MultipleToolbar}"><ContentPresenter ContentTemplate="{StaticResource BarMultiple}" /></DataTemplate>
                        <DataTemplate DataType="{x:Type m:TextElement}"><ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource BarText}" /></DataTemplate>
                        <DataTemplate DataType="{x:Type m:TableElement}"><ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource BarTable}" /></DataTemplate>
                        <DataTemplate DataType="{x:Type vm:CellEditor}"><ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource BarCell}" /></DataTemplate>
                        <DataTemplate DataType="{x:Type m:RectangleElement}"><ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource BarShape}" /></DataTemplate>
                        <DataTemplate DataType="{x:Type m:EllipseElement}"><ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource BarShape}" /></DataTemplate>
                        <DataTemplate DataType="{x:Type m:LineElement}"><ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource BarLine}" /></DataTemplate>
                        <DataTemplate DataType="{x:Type m:ImageElement}"><ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource BarImage}" /></DataTemplate>
                    </ContentControl.Resources>
                </ContentControl>
            </Border>

            <!-- ===== メッセージ バー（C# の式を実行していないとき） ===== -->
            <Border DockPanel.Dock="Top" Background="{StaticResource WarningBackground}" BorderBrush="{StaticResource WarningBorder}" BorderThickness="0,0,0,1" Padding="14,7"
                    Visibility="{Binding ShowScriptsBlocked, Converter={StaticResource BoolToVisibility}}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Padding="10,3" Content="C# の式を実行する" Command="{Binding TrustScriptsCommand}" VerticalAlignment="Center" />
                    <TextBlock Text="&#xE7BA;" FontFamily="{StaticResource IconFont}" Foreground="{StaticResource WarningText}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0" Foreground="{StaticResource WarningText}"
                               Text="このファイルの C# の式は実行していません。計算する差し込み項目は空になります。信頼できるファイルなら、実行できます。" />
                </DockPanel>
            </Border>

            <!-- ===== ステータスバー ===== -->
            <Border DockPanel.Dock="Bottom" Height="30" Background="White" BorderBrush="{StaticResource PanelBorder}" BorderThickness="0,1,0,0" Padding="8,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource StatusButton}" Click="ViewMenu_Click" AutomationProperties.Name="表示の設定" ToolTip="グリッド・部品の枠・ページの並べ方など">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE890;" FontFamily="{StaticResource IconFont}" FontSize="12" VerticalAlignment="Center" Margin="0,0,5,0" />
                                <TextBlock Text="表示" VerticalAlignment="Center" />
                                <TextBlock Text="&#xE70D;" FontFamily="{StaticResource IconFont}" FontSize="7" VerticalAlignment="Center" Margin="5,1,0,0" />
                            </StackPanel>
                        </Button>
                        <Border Width="1" Height="14" Background="{StaticResource PanelBorder}" Margin="8,0" />
                        <Button Style="{StaticResource StatusButton}" Command="{Binding ZoomOutCommand}" ToolTip="縮小 (Ctrl+-)" AutomationProperties.Name="縮小">
                            <TextBlock Text="&#xE738;" FontFamily="{StaticResource IconFont}" FontSize="10" />
                        </Button>
                        <Slider Width="110" Minimum="-1" Maximum="1" VerticalAlignment="Center" IsMoveToPointEnabled="True" Margin="4,0"
                                Value="{Binding Zoom, Converter={StaticResource ZoomSlider}}" ToolTip="表示倍率" AutomationProperties.Name="表示倍率のスライダー" />
                        <Button Style="{StaticResource StatusButton}" Command="{Binding ZoomInCommand}" ToolTip="拡大 (Ctrl++)" AutomationProperties.Name="拡大">
                            <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" FontSize="10" />
                        </Button>
                        <Button Style="{StaticResource StatusButton}" Click="ZoomMenu_Click" MinWidth="58" ToolTip="表示倍率を選ぶ" AutomationProperties.Name="表示倍率">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding ZoomText}" VerticalAlignment="Center" />
                                <TextBlock Text="&#xE70D;" FontFamily="{StaticResource IconFont}" FontSize="7" VerticalAlignment="Center" Margin="5,1,0,0" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource StatusButton}" Command="{Binding PreviousPageCommand}" ToolTip="前のページ (Ctrl+PageUp)" AutomationProperties.Name="前のページ">
                            <TextBlock Text="&#xE76B;" FontFamily="{StaticResource IconFont}" FontSize="10" />
                        </Button>
                        <TextBlock Text="{Binding PageStatusText}" VerticalAlignment="Center" Margin="4,0" />
                        <Button Style="{StaticResource StatusButton}" Command="{Binding NextPageCommand}" ToolTip="次のページ (Ctrl+PageDown)" AutomationProperties.Name="次のページ">
                            <TextBlock Text="&#xE76C;" FontFamily="{StaticResource IconFont}" FontSize="10" />
                        </Button>
                        <TextBlock Text="{Binding CursorText}" Foreground="{StaticResource SubtleText}" VerticalAlignment="Center" MinWidth="150" Margin="14,0,12,0" />
                        <ToggleButton x:Name="WarningsToggle" Padding="8,2" Focusable="False" BorderThickness="0" Background="Transparent" ToolTip="押すと、問題の一覧を表示します">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="11" Foreground="#047857" VerticalAlignment="Center" Margin="0,0,5,0"
                                           Visibility="{Binding Warnings.Count, Converter={StaticResource ZeroToVisible}}" />
                                <TextBlock Text="&#xE7BA;" FontFamily="{StaticResource IconFont}" FontSize="11" Foreground="#B45309" VerticalAlignment="Center" Margin="0,0,5,0"
                                           Visibility="{Binding Warnings.Count, Converter={StaticResource ZeroToVisible}, ConverterParameter=Inverse}" />
                                <TextBlock Text="{Binding WarningsText}" VerticalAlignment="Center" />
                            </StackPanel>
                        </ToggleButton>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- ===== 本体 ===== -->
            <Grid x:Name="BodyGrid">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition x:Name="NavigationColumn" Width="208" MinWidth="160" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" MinWidth="280" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition x:Name="PropertyColumn" Width="320" MinWidth="250" />
                </Grid.ColumnDefinitions>

                <!-- ===== ツールのレール ===== -->
                <Border Grid.Column="0" Background="White" BorderBrush="{StaticResource PanelBorder}" BorderThickness="0,0,1,0" Padding="6,6">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Bottom">
                            <Border Height="1" Background="{StaticResource PanelBorder}" Margin="6,4" />
                            <ToggleButton x:Name="PagesRailButton" Style="{StaticResource RailTool}" c:CommandBar.Icon="&#xF57E;" Content="ページ" Click="PagesPanel_Click"
                                          ToolTip="ページの一覧を表示・非表示" AutomationProperties.Name="ページの一覧" />
                            <ToggleButton x:Name="ElementsRailButton" Style="{StaticResource RailTool}" c:CommandBar.Icon="&#xE81E;" Content="部品" Click="ElementsPanel_Click"
                                          ToolTip="このページの部品の一覧を表示・非表示（重なりの順）" AutomationProperties.Name="部品の一覧" />
                        </StackPanel>
                        <StackPanel>
                            <RadioButton Style="{StaticResource RailTool}" GroupName="Tool" c:CommandBar.Icon="&#xE8B0;" Content="選択" AutomationProperties.Name="選択ツール"
                                         IsChecked="{Binding Tool, Converter={StaticResource EnumEquals}, ConverterParameter=Select}" ToolTip="部品を選んで、動かしたり大きさを変えたりします (Esc)" />
                            <RadioButton Style="{StaticResource RailTool}" GroupName="Tool" c:CommandBar.Icon="&#xE8D2;" Content="テキスト" AutomationProperties.Name="テキストツール"
                                         IsChecked="{Binding Tool, Converter={StaticResource EnumEquals}, ConverterParameter=Text}" ToolTip="文字の枠を置きます（用紙の上をドラッグ。クリックだけなら既定の大きさ）" />
                            <RadioButton Style="{StaticResource RailTool}" GroupName="Tool" c:CommandBar.Icon="&#xE80A;" Content="表" AutomationProperties.Name="表ツール"
                                         IsChecked="{Binding Tool, Converter={StaticResource EnumEquals}, ConverterParameter=Table}" ToolTip="表を置きます" />
                            <RadioButton Style="{StaticResource RailTool}" GroupName="Tool" c:CommandBar.Icon="&#xE91B;" Content="画像" AutomationProperties.Name="画像ツール"
                                         IsChecked="{Binding Tool, Converter={StaticResource EnumEquals}, ConverterParameter=Image}" ToolTip="画像（PNG / JPEG）を置きます" />
                            <RadioButton Style="{StaticResource RailTool}" GroupName="Tool" c:CommandBar.Icon="╱" c:CommandBar.IconFont="Segoe UI Symbol" Content="直線" AutomationProperties.Name="直線ツール"
                                         IsChecked="{Binding Tool, Converter={StaticResource EnumEquals}, ConverterParameter=Line}" ToolTip="直線を引きます（Shift で水平・垂直）" />
                            <RadioButton Style="{StaticResource RailTool}" GroupName="Tool" c:CommandBar.Icon="▭" c:CommandBar.IconFont="Segoe UI Symbol" Content="矩形" AutomationProperties.Name="矩形ツール"
                                         IsChecked="{Binding Tool, Converter={StaticResource EnumEquals}, ConverterParameter=Rectangle}" ToolTip="矩形を置きます" />
                            <RadioButton Style="{StaticResource RailTool}" GroupName="Tool" c:CommandBar.Icon="◯" c:CommandBar.IconFont="Segoe UI Symbol" Content="楕円" AutomationProperties.Name="楕円ツール"
                                         IsChecked="{Binding Tool, Converter={StaticResource EnumEquals}, ConverterParameter=Ellipse}" ToolTip="楕円を置きます" />
                            <Border Height="1" Background="{StaticResource PanelBorder}" Margin="6,4" />
                            <Button Style="{StaticResource RailButton}" c:CommandBar.Icon="{}{ }" c:CommandBar.IconFont="Consolas" Content="差し込み欄" Click="InsertFieldMenu_Click"
                                    ToolTip="差し込み欄 {名前} を書いたテキストを置きます" AutomationProperties.Name="差し込み欄を置く" />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- ===== 左のパネル（ページの一覧・部品の一覧） ===== -->
                <Border x:Name="NavigationPane" Grid.Column="1" Background="{StaticResource ChromeBackground}">
                    <Grid>
                        <!-- ページ -->
                        <DockPanel Visibility="{Binding NavigationTab, Converter={StaticResource EnumVisibility}, ConverterParameter=Pages}" Margin="10,10,10,10">
                            <DockPanel DockPanel.Dock="Top" Margin="2,0,0,8">
                                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE712;" Focusable="False" Click="PageMoreMenu_Click"
                                        ToolTip="ページの複製・削除・並べ替え・名前の変更" AutomationProperties.Name="ページの操作" />
                                <TextBlock Style="{StaticResource PaneTitle}" Text="ページ" />
                            </DockPanel>
                            <ToggleButton DockPanel.Dock="Top" Style="{StaticResource CommonCard}" IsChecked="{Binding IsEditingCommon}" Margin="0,0,0,8"
                                          ToolTip="すべてのページに描く部品（ヘッダー・フッター、ページ番号など）を編集します。用紙の上で共通の部品をダブルクリックしても編集できます"
                                          AutomationProperties.Name="全ページ共通の部品" />
                            <Button DockPanel.Dock="Bottom" Margin="0,8,0,0" HorizontalAlignment="Stretch" Command="{Binding AddPageCommand}" ToolTip="このページの後ろに、空のページを足します">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <TextBlock Text="ページを追加" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <ListBox x:Name="PageList" ItemsSource="{Binding PageItems}" Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource PageThumbItem}"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="PageList_SelectionChanged" KeyDown="PageList_KeyDown">
                                <ListBox.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="新しいページを追加(_N)" Command="{Binding AddPageCommand}" />
                                        <MenuItem Header="このページを複製(_D)" Command="{Binding DuplicatePageCommand}" />
                                        <MenuItem Header="このページを削除" Command="{Binding DeletePageCommand}" />
                                        <Separator />
                                        <MenuItem Header="前へ移動" Command="{Binding MovePageUpCommand}" />
                                        <MenuItem Header="後ろへ移動" Command="{Binding MovePageDownCommand}" />
                                        <Separator />
                                        <MenuItem Header="ページの名前を変更(_R)…" Click="RenamePage_Click" />
                                    </ContextMenu>
                                </ListBox.ContextMenu>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <Border Background="White" BorderBrush="#D4D4D8" BorderThickness="1" CornerRadius="2"
                                                    Width="{x:Static vm:PageItem.ThumbnailWidth}" Height="{Binding ThumbnailHeight}">
                                                <Border.Effect>
                                                    <DropShadowEffect BlurRadius="6" ShadowDepth="1" Direction="270" Opacity="0.12" />
                                                </Border.Effect>
                                                <Image Source="{Binding Thumbnail}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                                            </Border>
                                            <TextBlock Text="{Binding Label}" HorizontalAlignment="Center" Margin="0,5,0,0" TextTrimming="CharacterEllipsis" FontSize="11.5"
                                                       MaxWidth="{x:Static vm:PageItem.ThumbnailWidth}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>

                        <!-- 部品 -->
                        <DockPanel Visibility="{Binding NavigationTab, Converter={StaticResource EnumVisibility}, ConverterParameter=Elements}" Margin="10">
                            <DockPanel DockPanel.Dock="Top" Margin="2,0,0,2">
                                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE74B;" Command="{Binding SendBackwardCommand}" ToolTip="背面へ移動" AutomationProperties.Name="背面へ移動" />
                                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE74A;" Command="{Binding BringForwardCommand}" ToolTip="前面へ移動" AutomationProperties.Name="前面へ移動" />
                                <TextBlock Style="{StaticResource PaneTitle}" Text="部品" />
                            </DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="{Binding ElementListHeader}" Style="{StaticResource Hint}" Margin="2,0,0,6" />
                            <ListBox x:Name="ElementList" ItemsSource="{Binding Elements}" SelectionMode="Extended" Background="Transparent" BorderThickness="0"
                                     SelectionChanged="ElementList_SelectionChanged" KeyDown="ElementList_KeyDown">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Left" Text="{Binding KindName}" Foreground="{StaticResource SubtleText}" FontSize="11" Width="48" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                        </DockPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Grid>
                </Border>

                <GridSplitter x:Name="NavigationSplitter" Grid.Column="2" Width="5" HorizontalAlignment="Center" VerticalAlignment="Stretch" />

                <!-- ===== 中央: 用紙 ===== -->
                <Grid Grid.Column="3">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Border Background="{StaticResource AccentSoft}" BorderBrush="{StaticResource AccentSoftBorder}" BorderThickness="0,0,0,1" Padding="14,8"
                            Visibility="{Binding IsEditingCommon, Converter={StaticResource BoolToVisibility}}">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="編集を終える" Padding="12,4" Margin="8,0,0,0" Command="{Binding EditCommonCommand}" VerticalAlignment="Center" />
                            <TextBlock Text="&#xE8A1;" FontFamily="{StaticResource IconFont}" Foreground="{StaticResource AccentText}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{StaticResource AccentText}"
                                       Text="全ページ共通の部品を編集しています。ここに置いた部品は、すべてのページに描きます（薄く見えているのは、ページの部品です）。" />
                        </DockPanel>
                    </Border>
                    <ScrollViewer Grid.Row="1" x:Name="SurfaceScroll" ScrollChanged="SurfaceScroll_ScrollChanged" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                  Background="{StaticResource CanvasBackground}" Focusable="False" PreviewMouseWheel="SurfaceScroll_PreviewMouseWheel">
                        <Grid x:Name="SurfaceHost" HorizontalAlignment="Center" VerticalAlignment="Top">
                            <c:DesignSurface x:Name="Surface" />
                            <!-- その場で文字を編集する入力欄を置く層 -->
                            <Canvas x:Name="EditorLayer" />
                        </Grid>
                    </ScrollViewer>
                    <Border Grid.Row="2" Background="{StaticResource WarningBackground}" BorderBrush="{StaticResource WarningBorder}" BorderThickness="0,1,0,0" MaxHeight="160"
                            Visibility="{Binding IsChecked, ElementName=WarningsToggle, Converter={StaticResource BoolToVisibility}}">
                        <ListBox ItemsSource="{Binding Warnings}" Background="Transparent" BorderThickness="0" Padding="6" />
                    </Border>
                </Grid>

                <GridSplitter x:Name="PropertySplitter" Grid.Column="4" Width="5" HorizontalAlignment="Center" VerticalAlignment="Stretch" />

                <!-- ===== 右: インスペクター（選んだ部品の詳しい設定。何も選んでいなければ、ページと文書の設定） ===== -->
                <Border x:Name="PropertyPane" Grid.Column="5" Background="White">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="16,12,8,4">
                            <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE711;" Focusable="False" Click="ClosePropertyPane_Click"
                                    ToolTip="インスペクターを閉じる（ステータスバーの「表示」で開きます）" AutomationProperties.Name="インスペクターを閉じる" />
                            <TextBlock Style="{StaticResource PaneTitle}" Text="{Binding PropertyPaneTitle}" />
                        </DockPanel>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="16,0,14,16">
                                <StackPanel Visibility="{Binding HasNoSelection, Converter={StaticResource BoolToVisibility}}">
                                    <!-- ページ -->
                                    <StackPanel Visibility="{Binding IsEditingCommon, Converter={StaticResource InverseBoolToVisibility}}">
                                        <TextBlock Text="{Binding PageText}" Style="{StaticResource SectionHeader}" Margin="0,8,0,6" />
                                        <DockPanel Style="{StaticResource PropRow}">
                                            <TextBlock Text="名前" Style="{StaticResource PropLabel}" />
                                            <TextBox x:Name="PageNameBox" Text="{Binding CurrentPage.Name, UpdateSourceTrigger=PropertyChanged}" ToolTip="ページの一覧と、出力する C# コードのコメントに使います（例: 表紙）" />
                                        </DockPanel>
                                        <CheckBox Content="このページだけ用紙を変える" IsChecked="{Binding CurrentPageHasOwnPaper}" Margin="0,8,0,2"
                                                  ToolTip="オンにすると、このページだけ用紙の大きさや向きを変えられます（例: 表だけ A4 横）" />
                                        <StackPanel Visibility="{Binding CurrentPageHasOwnPaper, Converter={StaticResource BoolToVisibility}}" Margin="0,4,0,0">
                                            <DockPanel Style="{StaticResource PropRow}">
                                                <TextBlock Text="用紙" Style="{StaticResource PropLabel}" />
                                                <ComboBox ItemsSource="{x:Static vm:Choices.PaperNames}" SelectedItem="{Binding CurrentPage.Paper.PaperName}" />
                                            </DockPanel>
                                            <CheckBox Content="横向き" IsChecked="{Binding CurrentPage.Paper.Landscape}" Margin="106,2,0,2" />
                                            <StackPanel Visibility="{Binding CurrentPage.Paper.PaperName, Converter={StaticResource CustomPaperVisibility}}">
                                                <DockPanel Style="{StaticResource PropRow}">
                                                    <TextBlock Text="幅（mm）" Style="{StaticResource PropLabel}" />
                                                    <TextBox Text="{Binding CurrentPage.Paper.CustomWidth}" />
                                                </DockPanel>
                                                <DockPanel Style="{StaticResource PropRow}">
                                                    <TextBlock Text="高さ（mm）" Style="{StaticResource PropLabel}" />
                                                    <TextBox Text="{Binding CurrentPage.Paper.CustomHeight}" />
                                                </DockPanel>
                                            </StackPanel>
                                        </StackPanel>
                                        <CheckBox Content="このページには共通の部品を描かない" IsChecked="{Binding CurrentPage.HideCommon}" Margin="0,4,0,2"
                                                  ToolTip="全面に画像を置くページや、用紙の大きさが違って共通の部品の位置が合わないページで使います" />
                                    </StackPanel>
                                    <!-- 全ページ共通の部品 -->
                                    <StackPanel Visibility="{Binding IsEditingCommon, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,4"
                                                   Text="ここに置いた部品は、すべてのページに、ページの部品より奥に描きます。表紙などに描かないときは、部品の「描くページ」を「最初のページ以外」にします。" />
                                    </StackPanel>

                                    <!-- 文書 -->
                                    <TextBlock Text="文書" Style="{StaticResource SectionHeader}" Margin="0,22,0,6" />
                                    <DockPanel Style="{StaticResource PropRow}">
                                        <TextBlock Text="名前" Style="{StaticResource PropLabel}" />
                                        <TextBox Text="{Binding Report.Name, UpdateSourceTrigger=PropertyChanged}" ToolTip="PDF のタイトルと、出力するクラスの名前に使います" />
                                    </DockPanel>
                                    <DockPanel Style="{StaticResource PropRow}">
                                        <TextBlock Text="用紙" Style="{StaticResource PropLabel}" />
                                        <ComboBox ItemsSource="{x:Static vm:Choices.PaperNames}" SelectedItem="{Binding Report.PaperName}" />
                                    </DockPanel>
                                    <CheckBox Content="横向き" IsChecked="{Binding Report.Landscape}" Margin="106,2,0,2" />
                                    <StackPanel Visibility="{Binding Report.PaperName, Converter={StaticResource CustomPaperVisibility}}">
                                        <DockPanel Style="{StaticResource PropRow}">
                                            <TextBlock Text="幅（mm）" Style="{StaticResource PropLabel}" />
                                            <TextBox Text="{Binding Report.CustomWidth}" />
                                        </DockPanel>
                                        <DockPanel Style="{StaticResource PropRow}">
                                            <TextBlock Text="高さ（mm）" Style="{StaticResource PropLabel}" />
                                            <TextBox Text="{Binding Report.CustomHeight}" />
                                        </DockPanel>
                                    </StackPanel>
                                    <DockPanel Style="{StaticResource PropRow}">
                                        <TextBlock Text="既定のフォント" Style="{StaticResource PropLabel}" />
                                        <c:FontComboBox DataContext="{Binding Report}" FontName="{Binding DefaultFontName}"
                                                        ItemsSource="{Binding DataContext.FontNames, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        ToolTip="フォントを指定していない部品のフォント。TrueType のフォント（.ttf / .ttc）が使え、一覧にないフォントも名前を入力すれば使えます" />
                                    </DockPanel>
                                    <Expander Margin="0,10,0,0" Header="太字に使うフォント">
                                        <StackPanel Margin="0,6,0,0">
                                            <DataGrid ItemsSource="{Binding Report.Fonts}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                                                      HeadersVisibility="Column" GridLinesVisibility="Horizontal" MinHeight="50" CanUserSortColumns="False" SelectionUnit="Cell">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="フォント" Binding="{Binding Name}" Width="*" />
                                                    <DataGridTextColumn Header="太字のフォント" Binding="{Binding BoldName}" Width="*" />
                                                    <DataGridTemplateColumn Width="30">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <Button Style="{StaticResource IconButton}" Content="&#xE711;" FontSize="9" Padding="4" ToolTip="削除"
                                                                        Command="{Binding DataContext.RemoveFontCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                </DataGrid.Columns>
                                            </DataGrid>
                                            <Button HorizontalAlignment="Left" Margin="0,6,0,0" Command="{Binding AddFontCommand}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" FontSize="10" VerticalAlignment="Center" Margin="0,0,6,0" />
                                                    <TextBlock Text="追加" />
                                                </StackPanel>
                                            </Button>
                                            <TextBlock Style="{StaticResource Hint}" Text="太字にした文字は、ここで対応付けたフォントで描きます。対応がなければ、文字の輪郭を太らせて描きます。" />
                                        </StackPanel>
                                    </Expander>
                                </StackPanel>
                                <StackPanel Visibility="{Binding SelectionSummary, Converter={StaticResource NullToCollapsed}}" Margin="0,8,0,0">
                                    <TextBlock Style="{StaticResource Hint}" Text="位置を揃えるには、上の書式バーのボタンを使います。1 つだけ選ぶと、ここに詳しい設定が出ます。" />
                                </StackPanel>
                                <ContentControl x:Name="PropertyHost" Content="{Binding PanelTarget}" Focusable="False" />
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Grid>
        </DockPanel>
    </Border>
</Window>

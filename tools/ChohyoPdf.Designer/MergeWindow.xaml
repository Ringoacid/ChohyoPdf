<Window x:Class="ChohyoPdf.Designer.MergeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:ChohyoPdf.Designer.Controls"
        xmlns:vm="clr-namespace:ChohyoPdf.Designer.ViewModels"
        Title="差し込み" Width="1020" Height="700" MinWidth="780" MinHeight="520"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="White">

    <Window.Resources>
        <!-- 左の章の切り替え -->
        <Style x:Key="SectionNav" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource NormalText}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="8" Padding="10,8">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#EBEBEE" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="White" />
                                <Setter Property="Foreground" Value="{StaticResource AccentText}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- 章のアイコン（角の丸い四角） -->
        <Style x:Key="NavIcon" TargetType="Border">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Background" Value="{StaticResource AccentSoft}" />
            <Setter Property="Margin" Value="0,0,10,0" />
        </Style>
        <!-- 件数の小さな丸 -->
        <Style x:Key="CountPill" TargetType="Border">
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Background" Value="#E4E4E7" />
            <Setter Property="Padding" Value="7,0,7,1" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- 章の見出し -->
        <Style x:Key="PageTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="PageLead" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource SubtleText}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>

        <!-- 項目の一覧の 1 行（つまみ・名前・値の例・使用数） -->
        <DataTemplate x:Key="FieldRow">
            <Grid Height="36">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" MaxWidth="150" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <!-- ドラッグできることを示すつまみ（2 列 × 3 段の点） -->
                <UniformGrid Columns="2" Rows="3" Width="6" Height="10" Margin="4,0,10,0" VerticalAlignment="Center" ToolTip="用紙へドラッグすると、差し込み欄を置けます">
                    <UniformGrid.Resources>
                        <Style TargetType="Ellipse">
                            <Setter Property="Width" Value="2" />
                            <Setter Property="Height" Value="2" />
                            <Setter Property="Fill" Value="#A1A1AA" />
                        </Style>
                    </UniformGrid.Resources>
                    <Ellipse /><Ellipse /><Ellipse /><Ellipse /><Ellipse /><Ellipse />
                </UniformGrid>
                <ContentControl Grid.Column="1" Style="{StaticResource CodeChip}" Content="{Binding Name, Converter={StaticResource Braces}}" />
                <TextBlock Grid.Column="2" Margin="10,0,6,0" VerticalAlignment="Center" Foreground="{StaticResource SubtleText}" TextTrimming="CharacterEllipsis">
                    <TextBlock.Text>
                        <MultiBinding Converter="{StaticResource FieldExample}">
                            <Binding Path="Kind" />
                            <Binding Path="Format" />
                            <Binding Path="SampleValue" />
                            <Binding Path="IsComputed" />
                        </MultiBinding>
                    </TextBlock.Text>
                </TextBlock>
                <c:UsageBadge Grid.Column="3" Margin="0,0,4,0" ToolTip="用紙でこの項目を使っている数">
                    <c:UsageBadge.Count>
                        <MultiBinding Converter="{StaticResource UsageCount}">
                            <Binding />
                            <Binding Path="DataContext.UsageCounts" RelativeSource="{RelativeSource AncestorType=Window}" />
                        </MultiBinding>
                    </c:UsageBadge.Count>
                </c:UsageBadge>
            </Grid>
        </DataTemplate>

        <!-- 一覧の一覧の 1 行（名前・列の数・使用数） -->
        <DataTemplate x:Key="ListRow">
            <Grid Height="40">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Margin="4,0,0,0">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock FontSize="11" Foreground="{StaticResource SubtleText}">
                        <Run Text="{Binding Columns.Count, Mode=OneWay}" /><Run Text=" 列・確認用の行 " /><Run Text="{Binding SampleRows.Count, Mode=OneWay}" /><Run Text=" 件" />
                    </TextBlock>
                </StackPanel>
                <c:UsageBadge Grid.Column="1" IsList="True" Margin="0,0,4,0" ToolTip="この一覧をくり返している表の数">
                    <c:UsageBadge.Count>
                        <MultiBinding Converter="{StaticResource UsageCount}">
                            <Binding />
                            <Binding Path="DataContext.UsageCounts" RelativeSource="{RelativeSource AncestorType=Window}" />
                        </MultiBinding>
                    </c:UsageBadge.Count>
                </c:UsageBadge>
            </Grid>
        </DataTemplate>

        <!-- 確認用の行の表の列見出し（列名のチップと種類）。クリックで列を選ぶ -->
        <DataTemplate x:Key="SampleColumnHeader">
            <StackPanel>
                <ContentControl Style="{StaticResource CodeChip}" Content="{Binding Name, Converter={StaticResource Braces}}" Cursor="SizeAll"
                                ToolTip="用紙のテキストや、表のくり返し行のセルへドラッグすると、差し込み欄を置けます"
                                PreviewMouseLeftButtonDown="FieldDrag_MouseDown" />
                <TextBlock FontSize="11" Foreground="{StaticResource SubtleText}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis">
                    <TextBlock.Text>
                        <MultiBinding Converter="{StaticResource ColumnKindSummary}">
                            <Binding Path="Kind" />
                            <Binding Path="Format" />
                        </MultiBinding>
                    </TextBlock.Text>
                </TextBlock>
            </StackPanel>
        </DataTemplate>

        <Style x:Key="SampleColumnHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{StaticResource HeaderBackground}" />
            <!-- 選んでいる列の見出しは、内側に 2px の枠を付ける（枠の太さを 0 と 2 で切り替える） -->
            <Setter Property="BorderBrush" Value="{StaticResource SelectedColumnBorder}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <EventSetter Event="Click" Handler="SampleGridHeader_Click" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridColumnHeader">
                        <Grid>
                            <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{StaticResource GridLine}" BorderThickness="0,0,1,1" />
                            <Border BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" />
                            <ContentPresenter Margin="8,5" VerticalAlignment="Center" />
                            <Thumb x:Name="PART_LeftHeaderGripper" HorizontalAlignment="Left" Width="5" Cursor="SizeWE">
                                <Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="Transparent" /></ControlTemplate></Thumb.Template>
                            </Thumb>
                            <Thumb x:Name="PART_RightHeaderGripper" HorizontalAlignment="Right" Width="5" Cursor="SizeWE">
                                <Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="Transparent" /></ControlTemplate></Thumb.Template>
                            </Thumb>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource RowHover}" />
                </Trigger>
                <DataTrigger Value="True">
                    <DataTrigger.Binding>
                        <MultiBinding Converter="{StaticResource SameObject}">
                            <Binding Path="Column.Header" RelativeSource="{RelativeSource Self}" />
                            <Binding Path="DataContext.SelectedColumn" RelativeSource="{RelativeSource AncestorType=Window}" />
                        </MultiBinding>
                    </DataTrigger.Binding>
                    <Setter Property="Background" Value="{StaticResource RowSelected}" />
                    <Setter Property="BorderThickness" Value="2" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SampleRowHeaderStyle" TargetType="DataGridRowHeader">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridRowHeader">
                        <Border x:Name="Bd" Background="{StaticResource HeaderBackground}" BorderBrush="{StaticResource GridLine}" BorderThickness="0,0,1,1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.FontSize="11" TextElement.Foreground="{StaticResource SubtleText}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsRowSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource RowSelected}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 表の右端の「＋ 列」ボタン（縦長） -->
        <Style x:Key="AddColumnButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource AccentText}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Width="34" Background="{StaticResource AccentSoft}" BorderBrush="{StaticResource AccentSoftBorder}" BorderThickness="1" CornerRadius="0,8,8,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentSoftHover}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 書式の例の 1 行（左にコードチップ、右に結果） -->
        <DataTemplate x:Key="FormatExampleRow">
            <Grid Margin="0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="FormatCode" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ContentControl Style="{StaticResource CodeChip}" Content="{Binding Text}" />
                <TextBlock Grid.Column="1" Text="&#xE72A;" FontFamily="{StaticResource IconFont}" FontSize="11" Margin="10,0" Foreground="{StaticResource MutedText}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Text="{Binding Example}" VerticalAlignment="Center" TextWrapping="Wrap" />
            </Grid>
        </DataTemplate>

        <Style x:Key="CodeLine" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="FontFamily" Value="{StaticResource CodeFont}" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Padding" Value="8,6" />
        </Style>

        <!-- 章の見出しの右の「使い方」 -->
        <Style x:Key="HowToButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE768;" FontFamily="{StaticResource IconFont}" FontSize="11" Foreground="{StaticResource Accent}" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock Text="使い方" VerticalAlignment="Center" />
                        </StackPanel>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- 「＋ 追加」 -->
        <Style x:Key="AddButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Padding" Value="12,5" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid x:Name="DataContent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="216" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ===== 左: 章の一覧 ===== -->
            <Border Background="{StaticResource ChromeBackground}" BorderBrush="{StaticResource PanelBorder}" BorderThickness="0,0,1,0">
                <DockPanel Margin="12,16,12,14">
                    <StackPanel DockPanel.Dock="Top" Margin="6,0,0,14">
                        <TextBlock Text="差し込み" FontSize="16" FontWeight="SemiBold" />
                        <TextBlock Style="{StaticResource Hint}" Margin="0,3,0,0" Text="宛名や日付のように、PDF ごとに変わる文字をあとから入れる機能です。" />
                    </StackPanel>

                    <!-- 下: 結果の表示と、開いたまま使えることの案内 -->
                    <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" Padding="12,10">
                        <StackPanel>
                            <CheckBox Style="{StaticResource ToggleSwitch}" Content="結果を用紙に表示" IsChecked="{Binding ShowSampleValues}" AutomationProperties.Name="結果を用紙に表示"
                                      ToolTip="差し込み欄に確認用の値を入れて、用紙に表示します（タイトルバーの「結果を表示」と同じ）" />
                            <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0" Text="このウィンドウを開いたまま、用紙を編集できます。項目や列は、用紙へドラッグして置けます。" />
                        </StackPanel>
                    </Border>

                    <StackPanel>
                        <RadioButton Style="{StaticResource SectionNav}" GroupName="DataSection" AutomationProperties.Name="差し込み項目の章"
                                     IsChecked="{Binding DataSection, Converter={StaticResource EnumEquals}, ConverterParameter=Fields}">
                            <DockPanel>
                                <Border Style="{StaticResource NavIcon}">
                                    <TextBlock Text="{}{ }" FontFamily="Consolas" FontWeight="Bold" FontSize="11" Foreground="{StaticResource AccentText}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,1" />
                                </Border>
                                <Border DockPanel.Dock="Right" Style="{StaticResource CountPill}">
                                    <TextBlock Text="{Binding Report.Fields.Count, Mode=OneWay}" FontSize="11" FontWeight="Normal" Foreground="{StaticResource SubtleText}" />
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="差し込み項目" />
                                    <TextBlock Text="1 か所に 1 つの値" FontSize="11" FontWeight="Normal" Foreground="{StaticResource SubtleText}" />
                                </StackPanel>
                            </DockPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource SectionNav}" GroupName="DataSection" AutomationProperties.Name="一覧の章"
                                     IsChecked="{Binding DataSection, Converter={StaticResource EnumEquals}, ConverterParameter=Lists}">
                            <DockPanel>
                                <Border Style="{StaticResource NavIcon}" Background="#DCF5E6">
                                    <TextBlock Text="&#xE8FD;" FontFamily="{StaticResource IconFont}" FontSize="12" Foreground="#047857" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <Border DockPanel.Dock="Right" Style="{StaticResource CountPill}">
                                    <TextBlock Text="{Binding Report.Lists.Count, Mode=OneWay}" FontSize="11" FontWeight="Normal" Foreground="{StaticResource SubtleText}" />
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="一覧" />
                                    <TextBlock Text="件数が変わる表の行" FontSize="11" FontWeight="Normal" Foreground="{StaticResource SubtleText}" />
                                </StackPanel>
                            </DockPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource SectionNav}" GroupName="DataSection" AutomationProperties.Name="組み込みの欄の章"
                                     IsChecked="{Binding DataSection, Converter={StaticResource EnumEquals}, ConverterParameter=BuiltIns}">
                            <DockPanel>
                                <Border Style="{StaticResource NavIcon}" Background="#FEF3C7">
                                    <TextBlock Text="&#xE787;" FontFamily="{StaticResource IconFont}" FontSize="12" Foreground="#B45309" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="組み込みの欄" />
                                    <TextBlock Text="ページ番号・日付など" FontSize="11" FontWeight="Normal" Foreground="{StaticResource SubtleText}" />
                                </StackPanel>
                            </DockPanel>
                        </RadioButton>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- ===== 右: 章の中身 ===== -->
            <Grid Grid.Column="1">

                <!-- ===== 差し込み項目 ===== -->
                <DockPanel Visibility="{Binding DataSection, Converter={StaticResource EnumVisibility}, ConverterParameter=Fields}">
                    <DockPanel DockPanel.Dock="Top" Margin="24,18,24,14">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                            <Button Style="{StaticResource HowToButton}" Click="HowTo_Click" Tag="Fields" AutomationProperties.Name="差し込み項目の使い方" />
                            <Button Style="{StaticResource AddButton}" Command="{Binding AddFieldCommand}" AutomationProperties.Name="差し込み項目を追加">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <TextBlock Text="追加" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Style="{StaticResource PageTitle}" Text="差し込み項目" />
                            <TextBlock Style="{StaticResource PageLead}">
                                <Run Text="宛名・日付・金額のように、1 か所に 1 つの値を入れます。用紙に" /><Run Text=" {名前} " FontFamily="{StaticResource CodeFont}" Foreground="{StaticResource ChipText}" /><Run Text="と書いた所に入ります。" />
                            </TextBlock>
                        </StackPanel>
                    </DockPanel>

                    <!-- C# の式を実行していないときの案内 -->
                    <Border DockPanel.Dock="Top" Margin="24,0,24,12" Padding="12,8" Background="{StaticResource WarningBackground}" BorderBrush="{StaticResource WarningBorder}" BorderThickness="1" CornerRadius="8"
                            Visibility="{Binding ShowScriptsBlocked, Converter={StaticResource BoolToVisibility}}">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Padding="10,3" Content="C# の式を実行する" Command="{Binding TrustScriptsCommand}" VerticalAlignment="Center" />
                            <TextBlock TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{StaticResource WarningText}" Margin="0,0,10,0"
                                       Text="このファイルの C# の式は実行していません。計算する差し込み項目は空になります。" />
                        </DockPanel>
                    </Border>

                    <Grid>
                        <!-- 0 件: 使い方（実際の画面）と追加ボタン -->
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding Report.Fields.Count, Converter={StaticResource ZeroToVisible}}">
                            <Border Style="{StaticResource Card}" Margin="24,0,24,24" Padding="20" MaxWidth="660" VerticalAlignment="Top">
                                <StackPanel>
                                    <c:GuideView Steps="{x:Static c:Guides.Fields}" />
                                    <Button HorizontalAlignment="Center" Margin="0,16,0,0" Padding="14,6" Command="{Binding AddFieldCommand}" Content="最初の差し込み項目を追加" />
                                </StackPanel>
                            </Border>
                        </ScrollViewer>

                        <!-- 1 件以上: 左に一覧、右に選んだ項目の設定 -->
                        <Grid Visibility="{Binding Report.Fields.Count, Converter={StaticResource ZeroToVisible}, ConverterParameter=Inverse}" Margin="24,0,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="5*" MinWidth="250" />
                                <ColumnDefinition Width="6*" MinWidth="300" />
                            </Grid.ColumnDefinitions>
                            <DockPanel Margin="0,0,0,20">
                                <Expander DockPanel.Dock="Bottom" Margin="0,12,0,0" Header="プログラム（C#）から値を渡すには">
                                    <StackPanel Margin="0,6,0,0">
                                        <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,6"
                                                   Text="「C# コードを出力」で作るコードは、値を引数に受け取って PDF を作ります。値は次のように渡します。" />
                                        <TextBox Style="{StaticResource CodeLine}" Text="{Binding DataExample, Mode=OneWay}" TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto" MaxHeight="180" VerticalScrollBarVisibility="Auto" />
                                    </StackPanel>
                                </Expander>
                                <Border BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" CornerRadius="10" Padding="4">
                                    <ListBox x:Name="FieldList" ItemsSource="{Binding Report.Fields}" SelectedItem="{Binding SelectedField}"
                                             ItemTemplate="{StaticResource FieldRow}" BorderThickness="0" Background="Transparent"
                                             PreviewMouseLeftButtonDown="FieldDrag_MouseDown" PreviewMouseMove="FieldDrag_MouseMove" />
                                </Border>
                            </DockPanel>

                            <!-- 選んだ項目の設定 -->
                            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="20,0,24,20">
                                    <TextBlock Style="{StaticResource Hint}" Text="左の一覧で項目を選ぶと、ここで設定を変えられます。"
                                               Visibility="{Binding SelectedField, Converter={StaticResource NullToCollapsed}, ConverterParameter=Inverse}" />
                                    <StackPanel DataContext="{Binding SelectedField}" Visibility="{Binding DataContext.SelectedField, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource NullToCollapsed}}">
                                        <DockPanel Margin="0,0,0,10">
                                            <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE74D;" FontSize="13" ToolTip="この項目を削除"
                                                    Command="{Binding DataContext.RemoveFieldCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
                                                    AutomationProperties.Name="差し込み項目を削除" />
                                            <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE721;" FontSize="13" ToolTip="この項目を使っている部品を、用紙の上で選びます"
                                                    Command="{Binding DataContext.FindInPaperCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
                                                    AutomationProperties.Name="用紙から探す" />
                                            <ContentControl Style="{StaticResource CodeChip}" Content="{Binding Name, Converter={StaticResource Braces}}" MaxWidth="260" FontSize="13" />
                                        </DockPanel>
                                        <DockPanel Style="{StaticResource PropRow}">
                                            <TextBlock Text="名前" Style="{StaticResource PropLabel}" />
                                            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" ToolTip="テキストには {名前} と書きます" />
                                        </DockPanel>
                                        <DockPanel Style="{StaticResource PropRow}">
                                            <TextBlock Text="種類" Style="{StaticResource PropLabel}" />
                                            <ComboBox ItemsSource="{x:Static vm:Choices.FieldKinds}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Kind}"
                                                      ToolTip="数値と日付は、書式（3 桁区切り、年月日の書き方など）を選べます" />
                                        </DockPanel>
                                        <DockPanel Style="{StaticResource PropRow}" Visibility="{Binding Kind, Converter={StaticResource HasFormatVisibility}}">
                                            <TextBlock Text="書式" Style="{StaticResource PropLabel}" VerticalAlignment="Top" Margin="0,5,0,0" />
                                            <c:FormatPicker Kind="{Binding Kind}" Format="{Binding Format}" Sample="{Binding SampleValue}" />
                                        </DockPanel>
                                        <DockPanel Style="{StaticResource PropRow}" Visibility="{Binding IsComputed, Converter={StaticResource InverseBoolToVisibility}}">
                                            <TextBlock Text="確認用の値" Style="{StaticResource PropLabel}" />
                                            <TextBox Text="{Binding SampleValue, UpdateSourceTrigger=PropertyChanged}" ToolTip="「結果を表示」・プレビュー・PDF の出力で使う値（日付は 2026/10/20 のように書きます）" />
                                        </DockPanel>
                                        <CheckBox Margin="106,6,0,4" Content="C# の式で計算する" IsChecked="{Binding IsComputed}"
                                                  ToolTip="値を渡す代わりに、C# の式で計算します（例: 1 か月前の月、一覧の合計）" />
                                        <StackPanel Visibility="{Binding IsComputed, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Text="C# の式" Style="{StaticResource SectionHeader}" Margin="0,8,0,4" />
                                            <TextBox Text="{Binding Script, UpdateSourceTrigger=PropertyChanged, Delay=500}" AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap"
                                                     FontFamily="{StaticResource CodeFont}" FontSize="12" MinHeight="64" MaxHeight="240" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" />
                                            <TextBlock Style="{StaticResource Hint}">
                                                <Run Text="使える名前: " /><Run FontFamily="{StaticResource CodeFont}" Text="now" /><Run Text="（PDF を作る日時）、" />
                                                <Run FontFamily="{StaticResource CodeFont}" Text="data.項目の名前" /><Run Text="、" />
                                                <Run FontFamily="{StaticResource CodeFont}" Text="data.一覧の名前" /><Run Text="。例: " /><Run FontFamily="{StaticResource CodeFont}" Text="now.AddMonths(-1).Month" />
                                            </TextBlock>
                                            <TextBlock Margin="0,4,0,0" TextWrapping="Wrap" Text="{Binding DataContext.SelectedFieldScriptResult, RelativeSource={RelativeSource AncestorType=Window}}" />
                                        </StackPanel>
                                        <Expander Header="C# のコードでの値の入れ方" Margin="0,14,0,0" Foreground="{StaticResource SubtleText}">
                                            <TextBox Style="{StaticResource CodeLine}" Margin="0,6,0,0" Text="{Binding DataContext.SelectedFieldCode, RelativeSource={RelativeSource AncestorType=Window}, Mode=OneWay}" />
                                        </Expander>
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Grid>
                </DockPanel>

                <!-- ===== 一覧 ===== -->
                <DockPanel Visibility="{Binding DataSection, Converter={StaticResource EnumVisibility}, ConverterParameter=Lists}">
                    <DockPanel DockPanel.Dock="Top" Margin="24,18,24,14">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                            <Button Style="{StaticResource HowToButton}" Click="HowTo_Click" Tag="Lists" AutomationProperties.Name="一覧の使い方" />
                            <Button Style="{StaticResource AddButton}" Command="{Binding AddListCommand}" AutomationProperties.Name="一覧を追加">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <TextBlock Text="追加" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Style="{StaticResource PageTitle}" Text="一覧" />
                            <TextBlock Style="{StaticResource PageLead}" Text="名簿・明細・成績のように、件数が決まっていない値の並びです。表の緑色のくり返し行に、1 件ずつ並びます。" />
                        </StackPanel>
                    </DockPanel>

                    <Grid>
                        <!-- 0 件: 使い方（実際の画面）と追加ボタン -->
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding Report.Lists.Count, Converter={StaticResource ZeroToVisible}}">
                            <Border Style="{StaticResource Card}" Margin="24,0,24,24" Padding="20" MaxWidth="660" VerticalAlignment="Top">
                                <StackPanel>
                                    <c:GuideView Steps="{x:Static c:Guides.Lists}" />
                                    <Button HorizontalAlignment="Center" Margin="0,16,0,0" Padding="14,6" Command="{Binding AddListCommand}" Content="最初の一覧を追加" />
                                </StackPanel>
                            </Border>
                        </ScrollViewer>

                        <!-- 1 件以上: 左に一覧、右に選んだ一覧の列と確認用の行 -->
                        <Grid Visibility="{Binding Report.Lists.Count, Converter={StaticResource ZeroToVisible}, ConverterParameter=Inverse}" Margin="24,0,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" CornerRadius="10" Padding="4" Margin="0,0,0,20">
                                <ListBox ItemsSource="{Binding Report.Lists}" SelectedItem="{Binding SelectedList}" ItemTemplate="{StaticResource ListRow}" BorderThickness="0" Background="Transparent"
                                         AutomationProperties.Name="一覧の一覧" />
                            </Border>

                            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="20,0,24,20" Visibility="{Binding SelectedList, Converter={StaticResource NullToCollapsed}}">
                                    <DockPanel Margin="0,0,0,6">
                                        <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE74D;" FontSize="13" Command="{Binding RemoveListCommand}" ToolTip="この一覧を削除"
                                                AutomationProperties.Name="一覧を削除" />
                                        <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE721;" FontSize="13" Command="{Binding FindInPaperCommand}" CommandParameter="{Binding SelectedList}"
                                                ToolTip="この一覧をくり返している表を、用紙の上で選びます" AutomationProperties.Name="一覧を用紙から探す" />
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Left" Text="名前" Style="{StaticResource PropLabel}" Width="40" />
                                            <TextBox Text="{Binding SelectedList.Name, UpdateSourceTrigger=PropertyChanged}" MaxWidth="260" HorizontalAlignment="Left" MinWidth="160" />
                                        </DockPanel>
                                    </DockPanel>

                                    <!-- 列と確認用の行（1 つの表） -->
                                    <DockPanel Margin="0,14,0,6">
                                        <TextBlock DockPanel.Dock="Left" Text="列と確認用の行" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <WrapPanel HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <Button Style="{StaticResource LinkButton}" Content="Excel から貼り付け" Click="PasteSampleRows_Click"
                                                    ToolTip="Excel などでコピーした範囲を、行の終わりに追加します" />
                                            <Button Style="{StaticResource LinkButton}" Content="選んだ行を削除" Click="DeleteSampleRows_Click" Margin="12,0,0,0" />
                                        </WrapPanel>
                                    </DockPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <DataGrid x:Name="SampleGrid" AutoGenerateColumns="False" CanUserAddRows="True" CanUserDeleteRows="True" CanUserSortColumns="False"
                                                  CanUserReorderColumns="False" HeadersVisibility="All" RowHeaderWidth="32" ColumnHeaderHeight="46"
                                                  GridLinesVisibility="All" MinHeight="140" MaxHeight="300" SelectionUnit="CellOrRowHeader"
                                                  ColumnHeaderStyle="{StaticResource SampleColumnHeaderStyle}" RowHeaderStyle="{StaticResource SampleRowHeaderStyle}"
                                                  LoadingRow="SampleGrid_LoadingRow" PreviewMouseLeftButtonDown="SampleGrid_PreviewMouseLeftButtonDown" PreviewMouseMove="FieldDrag_MouseMove">
                                            <DataGrid.Resources>
                                                <!-- 左上の角（すべて選択のボタン）に「列」と書く -->
                                                <Style x:Key="{ComponentResourceKey ResourceId=DataGridSelectAllButtonStyle, TypeInTargetAssembly={x:Type DataGrid}}" TargetType="Button">
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border Background="{StaticResource HeaderBackground}" BorderBrush="{StaticResource GridLine}" BorderThickness="0,0,1,1">
                                                                    <TextBlock Text="列" FontSize="11" Foreground="{StaticResource SubtleText}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                </Border>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </DataGrid.Resources>
                                        </DataGrid>
                                        <Button Grid.Column="1" Style="{StaticResource AddColumnButton}" Margin="-1,0,0,0" Command="{Binding AddColumnCommand}"
                                                ToolTip="列を追加（確認用の行にも欄が増えます）" AutomationProperties.Name="列を追加">
                                            <StackPanel>
                                                <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" FontSize="11" HorizontalAlignment="Center" />
                                                <TextBlock Text="列" HorizontalAlignment="Center" Margin="0,4,0,0" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                    <TextBlock Style="{StaticResource Hint}" Text="いちばん上の段が列、その下が確認用の行（1 行 = 1 件）です。列見出しの {列の名前} を、用紙の表のセルへドラッグして置けます。" />

                                    <!-- 選んだ列の設定 -->
                                    <Border Margin="0,10,0,0" Padding="14,10" Background="{StaticResource HeaderBackground}" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" CornerRadius="10"
                                            Visibility="{Binding SelectedColumn, Converter={StaticResource NullToCollapsed}}">
                                        <StackPanel DataContext="{Binding SelectedColumn}">
                                            <DockPanel Margin="0,0,0,6">
                                                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE74D;" FontSize="13" ToolTip="この列を削除"
                                                        Command="{Binding DataContext.RemoveColumnCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
                                                        AutomationProperties.Name="列を削除" />
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="列" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0" />
                                                    <ContentControl Style="{StaticResource CodeChip}" Content="{Binding Name, Converter={StaticResource Braces}}" MaxWidth="160" />
                                                </StackPanel>
                                            </DockPanel>
                                            <DockPanel Style="{StaticResource PropRow}">
                                                <TextBlock Text="名前" Style="{StaticResource PropLabel}" />
                                                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" ToolTip="くり返し行のセルには {列の名前} と書きます" />
                                            </DockPanel>
                                            <DockPanel Style="{StaticResource PropRow}">
                                                <TextBlock Text="種類" Style="{StaticResource PropLabel}" />
                                                <ComboBox ItemsSource="{x:Static vm:Choices.FieldKinds}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Kind}" />
                                            </DockPanel>
                                            <DockPanel Style="{StaticResource PropRow}" Visibility="{Binding Kind, Converter={StaticResource HasFormatVisibility}}">
                                                <TextBlock Text="書式" Style="{StaticResource PropLabel}" VerticalAlignment="Top" Margin="0,5,0,0" />
                                                <c:FormatPicker Kind="{Binding Kind}" Format="{Binding Format}" />
                                            </DockPanel>
                                        </StackPanel>
                                    </Border>

                                    <Button HorizontalAlignment="Left" Margin="0,14,0,0" Padding="12,6" Command="{Binding InsertDetailTableCommand}" AutomationProperties.Name="この一覧の表を用紙に置く"
                                            ToolTip="見出しの行に列の名前、くり返し行に {列名} を入れた表を、編集しているページに置きます">
                                        <StackPanel Orientation="Horizontal">
                                            <c:TableOperationIcon Operation="DetailTable" Margin="0,0,8,0" />
                                            <TextBlock Text="この一覧の表を用紙に置く" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <Expander Header="C# のコードでの 1 件の追加のしかた" Margin="0,14,0,0" Foreground="{StaticResource SubtleText}">
                                        <StackPanel Margin="0,6,0,0">
                                            <TextBox Style="{StaticResource CodeLine}" Text="{Binding SelectedListCode, Mode=OneWay}" />
                                            <TextBox Style="{StaticResource CodeLine}" Margin="0,6,0,0" Text="{Binding SelectedColumnCode, Mode=OneWay}"
                                                     Visibility="{Binding SelectedColumnCode, Converter={StaticResource NullToCollapsed}}" />
                                        </StackPanel>
                                    </Expander>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Grid>
                </DockPanel>

                <!-- ===== 組み込みの欄 ===== -->
                <DockPanel Visibility="{Binding DataSection, Converter={StaticResource EnumVisibility}, ConverterParameter=BuiltIns}">
                    <DockPanel DockPanel.Dock="Top" Margin="24,18,24,14">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                            <Button Style="{StaticResource HowToButton}" Margin="0" Click="HowTo_Click" Tag="BuiltIns" AutomationProperties.Name="組み込みの欄の使い方" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Style="{StaticResource PageTitle}" Text="組み込みの欄" />
                            <TextBlock Style="{StaticResource PageLead}" Text="ページ番号や日付のように、値を渡さなくても入る欄です。日時は PDF を作った時のものが入ります。" />
                        </StackPanel>
                    </DockPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="24,0,24,24" Grid.IsSharedSizeScope="True" MaxWidth="720" HorizontalAlignment="Left">
                            <Border BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" CornerRadius="10">
                                <StackPanel>
                                    <Grid Background="{StaticResource HeaderBackground}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="BuiltInName" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="欄" FontSize="11.5" Foreground="{StaticResource SubtleText}" Margin="12,7" />
                                        <TextBlock Grid.Column="1" Text="いまの値" FontSize="11.5" Foreground="{StaticResource SubtleText}" Margin="4,7,12,7" />
                                    </Grid>
                                    <ItemsControl ItemsSource="{Binding BuiltInExamples}" Focusable="False">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border x:Name="Row" Height="38" BorderBrush="{StaticResource RowDivider}" BorderThickness="0,1,0,0" Background="Transparent">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" SharedSizeGroup="BuiltInName" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Orientation="Horizontal" Margin="12,0,14,0" MinWidth="130">
                                                            <ContentControl Style="{StaticResource CodeChip}" Content="{Binding Text}" />
                                                            <Button Style="{StaticResource IconButton}" Content="&#xE8C8;" Margin="4,0,0,0" Tag="{Binding Text}" Click="CopyBuiltIn_Click"
                                                                    ToolTip="この欄をコピー" AutomationProperties.Name="この欄をコピー" />
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="1" Text="{Binding Example}" ToolTip="{Binding Description}" VerticalAlignment="Center" Margin="4,0,12,0" TextTrimming="CharacterEllipsis" />
                                                    </Grid>
                                                </Border>
                                                <DataTemplate.Triggers>
                                                    <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Row" Property="Background" Value="{StaticResource RowHover}" />
                                                    </Trigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="書式を付ける" Style="{StaticResource SectionHeader}" Margin="0,22,0,4" />
                            <TextBlock Style="{StaticResource Hint}" Text="「:」のあとに書式を書きます。和暦は gg（元号）と y（和暦の年）で書きます。" />
                            <ItemsControl ItemsSource="{Binding FormatExamples}" ItemTemplate="{StaticResource FormatExampleRow}" Margin="0,6,0,0" Focusable="False" />
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Grid>
        </Grid>

        <!-- ===== 使い方（ウィンドウの上に重ねる） ===== -->
        <Grid Visibility="{Binding IsGuideOpen, Converter={StaticResource BoolToVisibility}}">
            <Border x:Name="GuideBackdrop" Background="#7318181B" MouseLeftButtonDown="GuideBackdrop_MouseLeftButtonDown" />
            <Grid Width="640" VerticalAlignment="Center" Margin="0,24">
                <!-- 影は文字と別の要素に付ける（文字がにじまないように） -->
                <Border Background="White" CornerRadius="14">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="30" ShadowDepth="8" Direction="270" Opacity="0.25" Color="Black" />
                    </Border.Effect>
                </Border>
                <Border x:Name="GuideDialog" Background="White" CornerRadius="14" Focusable="True" FocusVisualStyle="{x:Null}" Padding="22,16,22,20"
                        KeyboardNavigation.TabNavigation="Cycle" PreviewKeyDown="GuideDialog_PreviewKeyDown" AutomationProperties.Name="使い方">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                            <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE711;" Command="{Binding CloseGuideCommand}"
                                    ToolTip="閉じる (Esc)" AutomationProperties.Name="使い方を閉じる" />
                            <TextBlock x:Name="GuideTitle" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" Text="使い方" />
                        </DockPanel>
                        <c:GuideView x:Name="GuideSteps" />
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>

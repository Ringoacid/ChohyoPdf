<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- PDF のページを画像にする Windows.Data.Pdf を使うため、Windows 10 の SDK を指定する -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <LangVersion>14</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>ChohyoPdf.Designer</RootNamespace>
    <AssemblyName>ChohyoPdfDesigner</AssemblyName>
    <Product>ChohyoPdf Designer</Product>
    <IsPackable>false</IsPackable>
    <!-- 配布する ZIP を小さくするため、Roslyn などのリソースは日本語だけを含める -->
    <SatelliteResourceLanguages>ja</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <!-- 差し込みの使い方に出す、実際の画面の画像 -->
    <Resource Include="Images\Guide\*.png" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ChohyoPdf.Designer.Core\ChohyoPdf.Designer.Core.csproj" />
  </ItemGroup>

</Project>

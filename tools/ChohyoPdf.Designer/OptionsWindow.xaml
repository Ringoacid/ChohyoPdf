<Window x:Class="ChohyoPdf.Designer.OptionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="オプション" Width="460" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False" Background="White">
    <DockPanel Margin="16,12">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="OK" Width="80" IsDefault="True" Click="Ok_Click" />
            <Button Content="キャンセル" Width="80" Margin="8,0,0,0" IsCancel="True" />
        </StackPanel>
        <StackPanel>
            <TextBlock Text="デザイン画面" Style="{StaticResource SectionHeader}" Margin="0,0,0,4" />
            <CheckBox Content="ページをつなげて表示する" IsChecked="{Binding ContinuousPages}" />
            <TextBlock Style="{StaticResource Hint}" Margin="22,0,0,6" Text="すべてのページを縦に並べてスクロールできるようにします。クリックしたページを編集します。オフにすると、左のパネルで選んだページだけを表示します。ステータスバーの「表示」でも切り替えられます。" />
            <TextBlock Text="フォントの一覧" Style="{StaticResource SectionHeader}" />
            <CheckBox Content="フォント名をそのフォントで表示する" IsChecked="{Binding ShowFontFaces}" />
            <TextBlock Style="{StaticResource Hint}" Margin="22,0,0,6" Text="フォントの一覧を開いたときに、それぞれのフォントの見本を表示します。フォントが多いと、一覧を開くのが遅くなることがあります。" />
            <CheckBox Content="マウスを重ねたフォントを、デザイン画面でプレビューする" IsChecked="{Binding LiveFontPreview}" />
            <TextBlock Style="{StaticResource Hint}" Margin="22,0,0,0" Text="フォントの一覧でマウスを重ねると、選んでいる部品にそのフォントを仮に適用して表示します（クリックするまでデザインは変わりません）。ページを描き直すため、動作が重くなることがあります。" />
        </StackPanel>
    </DockPanel>
</Window>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net462;netstandard2.0;net8.0;net10.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>ChohyoPdf</RootNamespace>
    <AssemblyName>ChohyoPdf</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <Deterministic>true</Deterministic>

    <PackageId>ChohyoPdf</PackageId>
    <Version>0.1.1</Version>
    <Authors>Ringoacid</Authors>
    <Copyright>Copyright (c) 2026 Ringoacid</Copyright>
    <Description>MIT ライセンスの PDF 生成ライブラリ。日本語テキスト（TrueType サブセット埋め込み・禁則処理）、表、画像、図形、自動折り返し・自動改ページに対応。.NET Framework 4.6.2 以降 / .NET Standard 2.0 / .NET 8 / .NET 10。</Description>
    <PackageTags>pdf;japanese;report;帳票;table;layout</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/Ringoacid/ChohyoPdf</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Ringoacid/ChohyoPdf</RepositoryUrl>
    <RepositoryType>git</RepositoryType>

    <!-- デバッグ時にソースをたどれるよう、シンボルパッケージ（.snupkg）と Source Link の情報を含める -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ChohyoPdf.Tests" />
  </ItemGroup>

</Project>
